# Existing MyNaai REST API. Leave unset in local Vite dev to use the proxy.
VITE_API_BASE_URL=https://backend.mynaai.in

# ── Booking alerts (web push) ─────────────────────────────────────────────
# These turn the login-page "Allow alerts" flow ON. Without them the portal
# deliberately hides every alerts prompt and logs in without a device token —
# so a fresh build is fully usable before alerts are wired in.
# All values are browser-safe by design (they bundle into public JS).
#
# Firebase Console (console.firebase.google.com) → your MyNaai project →
# Project settings → Your apps → register a Web app (</> icon):
VITE_FIREBASE_API_KEY=            # e.g. AIzaSy... (Web API Key)
VITE_FIREBASE_AUTH_DOMAIN=        # e.g. your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=         # e.g. your-project
VITE_FIREBASE_STORAGE_BUCKET=     # e.g. your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=# e.g. 1234567890
VITE_FIREBASE_APP_ID=             # e.g. 1:1234567890:web:abc123...
# Project settings → Cloud Messaging → Web configuration →
# Web Push certificates → Generate key pair → copy the PUBLIC key:
VITE_FIREBASE_VAPID_KEY=

# Public Razorpay key ID used by Checkout (never put a secret here).
VITE_RAZORPAY_KEY_ID=
