+// ── The admin panel's own inbox ──────────────────────────────────────────────
+// The panel's Notifications tab is built from two kinds of row (see
+// getAdminNotificationList): what an admin sent, and the API's own event rows
+// (targetType ADMINS) — a new order, a salon registration, a renewal, a
+// delivery-partner action, a booking request.
+//
+// Only the event rows are "for" the admins in the unread sense: a row an admin
+// sent is not an unread message *to* them. So the badge counts unread events,
+// and opening the tab clears exactly those.
+const getAdminNotificationCount = async () => {
+    return await db.AdminNotification.count({
