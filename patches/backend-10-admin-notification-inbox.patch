+const adminNotificationService = require('../../services/adminNotification.service');
+
+// Called when an admin opens the Notifications tab (and by its "Mark all read"
+// action): the event rows stop being unread, so the sidebar badge clears.
+// Only ADMINS rows are touched — an admin's own sent notifications are not
+// unread messages to them, and never carry a badge.
+const markAdminNotificationsRead = async (request, response) => {
+    try {
+        const updated = await adminNotificationService.markAdminNotificationsRead();
+        return response.status(200).json({
+            status: 'SUCCESS',
+            message: 'Notifications marked as read',
+            updated: updated || 0
+        });
+    } catch (error) {
+        console.error('Error marking admin notifications as read:', error);
+        return response.status(500).json({
+            status: 'FAILED',
+            message: error.message
+        });
+    }
+};
+
+module.exports = markAdminNotificationsRead;
