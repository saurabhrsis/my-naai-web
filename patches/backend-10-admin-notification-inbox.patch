+const adminNotificationService = require('../../services/adminNotification.service');
+
+// The unread-event badge on the panel's Notifications tab. Always answers
+// SUCCESS with a number: a badge is not worth a 404, and a brand-new install
+// simply has zero.
+const getAdminNotificationCount = async (request, response) => {
+    try {
+        const notification = await adminNotificationService.getAdminNotificationCount();
+        return response.status(200).json({
+            status: 'SUCCESS',
+            message: 'Notification count fetched successfully',
+            notification: notification || 0
+        });
+    } catch (error) {
+        console.error('Error fetching admin notification count:', error);
+        return response.status(200).json({
+            status: 'SUCCESS',
+            message: 'Notification count unavailable',
+            notification: 0
+        });
+    }
+};
+
+module.exports = getAdminNotificationCount;
