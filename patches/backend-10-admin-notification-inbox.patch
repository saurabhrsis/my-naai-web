+++ b/scripts/test-admin-notification-inbox.js
@@ -0,0 +1,125 @@
+// The admin panel's Notifications tab — self-check that needs no database.
+//
+//   npm run notification:test-inbox
+//
+// The tab shows two kinds of row: what an admin sent (createdBy = that admin)
+// and the API's own event rows (targetType = 'ADMINS'). Only the event rows are
+// unread messages TO an admin, so:
+//
+//   • the sidebar badge counts unread ADMINS rows;
+//   • "mark all read" clears exactly those, and nothing else.
+//
+// This stubs the Sequelize model in Node's require cache and checks both.
+const path = require('path');
+const assert = require('assert');
+const Module = require('module');
+
+// The service also imports `sequelize` for its operators. Only the database
+// layer matters here, and a fresh checkout has no node_modules, so the package
+// is stubbed at the loader instead of being installed.
+const originalLoad = Module._load;
+const OPERATORS = { or: Symbol('or'), in: Symbol('in'), ne: Symbol('ne'), iLike: Symbol('iLike'), and: Symbol('and') };
+Module._load = function load(request, parent, isMain) {
+    if (request === 'sequelize') return { Op: OPERATORS };
+    return originalLoad.call(this, request, parent, isMain);
+};
+
+const ROOT = path.join(__dirname, '..');
+const modelsPath = require.resolve(path.join(ROOT, 'src/database/models'));
+
+const calls = { count: [], update: [], list: [] };
+const fakeDb = {
+    AdminNotification: {
+        findAndCountAll: async ({ where, limit, offset }) => {
+            calls.list.push({ where, limit, offset });
+            return { count: 0, rows: [] };
+        },
+        count: async ({ where }) => {
+            calls.count.push(where);
+            return fakeDb.unread;
+        },
+        update: async (values, { where }) => {
+            calls.update.push({ values, where });
+            return [fakeDb.changed];
+        },
+    },
+};
+fakeDb.unread = 3;
+fakeDb.changed = 3;
+
+// The service also pulls the FCM sender (which pulls firebase-admin); nothing
+// in this check sends a push, so it is stubbed too.
+const firebasePath = require.resolve(path.join(ROOT, 'src/firebase/sendNotification'));
+
+require.cache[modelsPath] = { id: modelsPath, filename: modelsPath, loaded: true, exports: fakeDb };
+require.cache[firebasePath] = { id: firebasePath, filename: firebasePath, loaded: true, exports: async () => true };
+
+const service = require(path.join(ROOT, 'src/services/adminNotification.service.js'));
+
+const check = async (label, fn) => {
+    await fn();
+    console.log(`  ✓ ${label}`);
+};
+
+(async () => {
+    console.log('\nAdmin notification inbox checks\n');
+
+    await check('the badge counts unread event rows only', async () => {
+        calls.count.length = 0;
+        const total = await service.getAdminNotificationCount();
+        assert.strictEqual(total, 3);
+        assert.deepStrictEqual(calls.count[0], { targetType: 'ADMINS', isRead: false });
+    });
+
+    await check('marking read touches unread event rows and reports how many', async () => {
+        calls.update.length = 0;
+        const updated = await service.markAdminNotificationsRead();
+        assert.strictEqual(updated, 3);
+        assert.deepStrictEqual(calls.update[0].values, { isRead: true });
+        assert.deepStrictEqual(calls.update[0].where, { targetType: 'ADMINS', isRead: false });
+    });
+
+    await check('an empty inbox is zero, not an error', async () => {
+        fakeDb.unread = 0;
+        const total = await service.getAdminNotificationCount();
+        assert.strictEqual(total, 0);
+        fakeDb.unread = 3;
+    });
+
+    await check('the events feed asks for the API event rows only', async () => {
+        calls.list.length = 0;
+        await service.getAdminNotificationList({ adminId: 7, feed: 'events' });
+        const conditions = calls.list[0].where[OPERATORS.and];
+        assert.ok(Array.isArray(conditions), 'conditions are ANDed');
+        assert.ok(conditions.some(condition => condition.targetType === 'ADMINS'));
+        assert.deepStrictEqual(conditions[0], { [OPERATORS.or]: [{ createdBy: 7 }, { targetType: 'ADMINS' }] });
+    });
+
+    await check('the sent feed asks for everything except the event rows', async () => {
+        calls.list.length = 0;
+        await service.getAdminNotificationList({ adminId: 7, feed: 'sent' });
+        const conditions = calls.list[0].where[OPERATORS.and];
+        assert.ok(conditions.some(condition => condition.targetType && condition.targetType[OPERATORS.ne] === 'ADMINS'));
+    });
+
+    await check('a search narrows the inbox instead of widening it', async () => {
+        calls.list.length = 0;
+        await service.getAdminNotificationList({ adminId: 7, searchString: 'order' });
+        const conditions = calls.list[0].where[OPERATORS.and];
+        assert.strictEqual(conditions.length, 2, 'scope + search, not a bare OR');
+        assert.deepStrictEqual(conditions[0][OPERATORS.or], [{ createdBy: 7 }, { targetType: 'ADMINS' }], 'the permission scope is still applied');
+        assert.ok(Array.isArray(conditions[1][OPERATORS.or]), 'the search is its own OR group');
+    });
+
+    await check('a failed count propagates so the controller can degrade to 0', async () => {
+        const original = fakeDb.AdminNotification.count;
+        fakeDb.AdminNotification.count = async () => { throw new Error('db down'); };
+        await assert.rejects(() => service.getAdminNotificationCount(), /db down/);
+        fakeDb.AdminNotification.count = original;
+    });
+
+    console.log('\nAll admin notification inbox checks passed.\n');
+})().catch((error) => {
+    console.error('\n✗ Admin notification inbox check failed:', error.message, '\n');
+    process.exit(1);
+});
