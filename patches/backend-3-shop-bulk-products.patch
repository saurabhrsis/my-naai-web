new file mode 100644
index 0000000..9e6ffac
--- /dev/null
+++ b/src/controller/shopProduct/bulkImportShopProducts.js
@@ -0,0 +1,55 @@
+const shopProductBulkService = require('../../services/shopProductBulk.service');
+
+/**
+ * POST /api/shop-products/bulk/import  (multipart/form-data)
+ *
+ *   file    .xlsx | .csv, ≤ 5 MB, ≤ 1000 rows   (required)
+ *   mode    CREATE_ONLY | UPSERT                (default CREATE_ONLY)
+ *   dryRun  true | false                        (default false)
+ *
+ * `dryRun: true` validates and reports, writes nothing — the admin panel always
+ * calls it first and only then asks "Import 112?".
+ *
+ * `status` stays SUCCESS when at least one row was written, with the problematic
+ * rows in `data.rows`; when nothing could be written the answer is FAILED and
+ * still carries the same report, because the report IS the answer.
+ */
+const bulkImportShopProducts = async (request, response) => {
+    try {
+        const file = request.file;
+        if (!file || !file.buffer) {
+            return response.status(400).json({
+                status: 'FAILED',
+                message: 'No file received — attach the spreadsheet in the "file" field'
+            });
+        }
+
+        const { mode, dryRun } = request.body || {};
+        const { ok, report } = await shopProductBulkService.importFromFile({
+            buffer: file.buffer,
+            originalname: file.originalname,
+            mode,
+            dryRun,
+            adminId: request.admin?.id
+        });
+
+        const { rows, created, updated, skipped, failed } = report.summary;
+        const message = report.dryRun
+            ? `${created} to add · ${updated} to update · ${skipped} already exist · ${failed} need fixing`
+            : `${created} added · ${updated} updated · ${skipped} skipped · ${failed} failed (of ${rows} rows)`;
+
+        return response.status(200).json({
+            status: ok ? 'SUCCESS' : 'FAILED',
+            message,
+            data: report
+        });
+    } catch (error) {
+        console.error('BULK IMPORT SHOP PRODUCTS ERROR:', error);
+        return response.status(error.status || 500).json({
+            status: 'FAILED',
+            message: error.message
+        });
+    }
+};
+
+module.exports = bulkImportShopProducts;
diff --git a/src/controller/shopProduct/downloadBulkTemplate.js b/src/controller/shopProduct/downloadBulkTemplate.js
new file mode 100644
index 0000000..3fb8378
--- /dev/null
+++ b/src/controller/shopProduct/downloadBulkTemplate.js
@@ -0,0 +1,40 @@
+const shopProductBulkService = require('../../services/shopProductBulk.service');
+
+/**
+ * GET /api/shop-products/bulk/template?format=xlsx|csv
+ *
+ * Answers the sample file itself. Generated from the importer's own column list
+ * (shopProductBulk.service.COLUMNS), so "the template's headers" and "what the
+ * importer accepts" are the same fact and cannot drift.
+ *
+ * It is sent as an attachment with a plain file name, because the admin is
+ * expected to save it, fill it in and upload it back.
+ */
+const downloadBulkTemplate = async (request, response) => {
+    try {
+        const format = String(request.query?.format || request.body?.format || 'xlsx').toLowerCase();
+
+        if (format === 'csv') {
+            const csv = shopProductBulkService.buildCsvTemplate();
+            response.setHeader('Content-Type', 'text/csv; charset=utf-8');
+            response.setHeader('Content-Disposition', 'attachment; filename="naai-shop-product-template.csv"');
+            return response.status(200).send(csv);
+        }
+
+        const buffer = await shopProductBulkService.buildTemplate();
+        response.setHeader('Content-Type', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');
+        response.setHeader('Content-Disposition', 'attachment; filename="naai-shop-product-template.xlsx"');
+        // A generated file has no business being cached by a proxy: the header
+        // row changes the day a column is added.
+        response.setHeader('Cache-Control', 'no-store');
+        return response.status(200).send(buffer);
+    } catch (error) {
+        console.error('DOWNLOAD BULK TEMPLATE ERROR:', error);
+        return response.status(error.status || 500).json({
+            status: 'FAILED',
+            message: error.message
+        });
+    }
+};
+
+module.exports = downloadBulkTemplate;
