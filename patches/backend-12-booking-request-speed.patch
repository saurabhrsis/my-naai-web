+// A cache for the two booking-request summaries — and nothing else.
+//
+// Why it exists: both tabs poll their counters (the admin panel re-reads them
+// every 20 seconds) and both are built from the same expensive aggregates — a
+// GROUP BY over the window, a per-salon roll-up and a `percentile_cont` for the
+// median reply. Answering the same question with the same rows twice inside a
+// few seconds is pure cost: the numbers cannot have changed in a way the panel
+// would notice, and the panel's own answer is one poll behind either way.
+//
+// What keeps it honest:
+//   · the TTL is short (15 s by default) — a filter change is answered fresh;
+//   · every write path that can change a request calls `clear()` on the way out
+//     (an accept, a reject, a delay, an auto-cancel, a new request), so the
+//     number a screen shows after an action is the number the row now has;
+//   · the key is the exact argument set, so two ranges never share an entry;
+//   · it is bounded, so a pathological set of filters cannot grow it.
+//
+// It is deliberately a plain in-process Map: one API process per instance, and a
+// cold cache costs one query, not a wrong answer.
+const createShortCache = ({ ttlMs = 15000, maxEntries = 64 } = {}) => {
+    const entries = new Map();
+
+    const isFresh = (entry) => Boolean(entry) && Date.now() - entry.at < ttlMs;
+
+    return {
+        get(key) {
+            const entry = entries.get(key);
+            if (!isFresh(entry)) {
+                if (entry) entries.delete(key);
+                return { hit: false, value: undefined };
+            }
+            return { hit: true, value: entry.value };
+        },
+        set(key, value) {
+            entries.set(key, { at: Date.now(), value });
+            if (entries.size > maxEntries) {
+                // Drop the oldest — a Map keeps insertion order, and a bucket
+                // that has just been written is the one worth keeping.
+                const oldest = entries.keys().next().value;
+                if (oldest !== undefined) entries.delete(oldest);
+            }
+            return value;
+        },
+        /** Answer from the cache when it can, otherwise compute and remember. */
+        async remember(key, producer) {
+            const hit = this.get(key);
+            if (hit.hit) return hit.value;
+            return this.set(key, await producer());
+        },
+        clear() {
+            entries.clear();
+        },
+        get size() {
+            return entries.size;
+        }
+    };
+};
+
+// One cache shared by the service that fills it and the writers that empty it.
+const leadSummaryCache = createShortCache({ ttlMs: 15000, maxEntries: 64 });
+
+module.exports = {
+    createShortCache,
+    leadSummaryCache
+};
