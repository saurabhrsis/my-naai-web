diff --git a/scripts/test-booking-request-speed.js b/scripts/test-booking-request-speed.js
new file mode 100644
index 0000000..53649d7
--- /dev/null
+++ b/scripts/test-booking-request-speed.js
@@ -0,0 +1,205 @@
+// Booking-request list speed — the three things that made the tabs slow.
+//
+//   node scripts/test-booking-request-speed.js
+//
+// No `npm ci`, no database, no network: `sequelize` and the model layer are
+// stubbed through `Module._load`, and the timings are simulated by a promise
+// that never settles (the sweep) and by counting queries (the summaries).
+//
+// What it checks:
+//   1. a list does NOT wait for the expiry sweep — the read returns while the
+//      bulk UPDATE is still running;
+//   2. the count is a plain `COUNT(*)` unless a search joins another table
+//      (which is the only case that needs `distinct` + `subQuery: false`);
+//   3. the admin summary answers from its 15-second cache, and a write clears
+//      that cache so the counters can never lag behind an answer;
+//   4. the indexes the tabs need are created idempotently and concurrently.
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const Module = require('module');
+
+const ROOT = path.join(__dirname, '..');
+const read = (relative) => fs.readFileSync(path.join(ROOT, relative), 'utf8');
+
+// ── stubs ───────────────────────────────────────────────────────────────────
+const calls = { pagedQuery: [], grouped: 0, salonNames: 0, counts: 0, max: 0 };
+let sweepCalls = 0;
+let sweepPending = null; // set to a promise to simulate a slow sweep
+
+const row = {
+    bookingRequestId: 'req-1',
+    customerId: 'cust-1',
+    salonId: 'salon-1',
+    serviceIds: [],
+    bookingDate: '2026-11-06',
+    startTime: '18:30:00',
+    status: 'PENDING',
+    expiresAt: null,
+    createdAt: new Date(),
+    customer: null,
+    salon: { salonName: 'Glow Studio', city: 'Nagpur' },
+    barber: null
+};
+
+const fakeDb = {
+    sequelize: {
+        query: async (sql) => {
+            if (/UPDATE booking_requests/i.test(sql)) {
+                sweepCalls += 1;
+                if (sweepPending) return sweepPending;
+                return [];
+            }
+            return [];
+        }
+    },
+    BookingRequest: {
+        findAndCountAll: async (options) => {
+            calls.pagedQuery.push(options);
+            return { count: 1, rows: [row] };
+        },
+        findAll: async (options) => {
+            // The per-salon roll-up groups by salonId; the status counts group
+            // by the derived status expression — only the former is counted here.
+            if (Array.isArray(options?.group) && options.group.includes('salonId')) {
+                calls.grouped += 1;
+                return [{ salonId: 'salon-1', status: 'ACCEPTED', total: 1 }];
+            }
+            calls.counts += 1; // countByStatus
+            return [{ status: 'ACCEPTED', total: 1 }];
+        },
+        max: async () => { calls.max += 1; return new Date(); }
+    },
+    Salon: { findAll: async () => { calls.salonNames += 1; return [{ salonId: 'salon-1', salonName: 'Glow Studio', city: 'Nagpur' }]; } },
+    User: {},
+    Barber: {},
+    Service: {}
+};
+
+const fakeSequelize = {
+    Op: { in: 'in', gt: 'gt', gte: 'gte', lt: 'lt', lte: 'lte', iLike: 'iLike', or: 'or', and: 'and' },
+    fn: (...args) => ({ fn: args }),
+    col: (name) => ({ col: name }),
+    literal: (value) => ({ literal: value }),
+    QueryTypes: { SELECT: 'SELECT' }
+};
+
+const originalLoad = Module._load;
+Module._load = function load(request, parent, isMain) {
+    if (request === 'sequelize') return fakeSequelize;
+    if (/database[\\/]models$/.test(request)) return fakeDb;
+    if (/ensureShopSchema$/.test(request)) return { ensureShopSchema: async () => {} };
+    if (/firebase[\\/]sendNotification$/.test(request)) return async () => ({});
+    return originalLoad.apply(this, arguments);
+};
+
+const leadService = require('../src/services/bookingRequestLead.service');
+const { leadSummaryCache } = require('../src/utils/shortCache');
+
+let passed = 0;
+const check = async (name, fn) => {
+    try {
+        await fn();
+        passed += 1;
+        console.log(`  ✓ ${name}`);
+    } catch (error) {
+        console.error(`  ✗ ${name}\n    ${error.message}`);
+        process.exitCode = 1;
+    }
+};
+
+const reset = () => {
+    calls.pagedQuery.length = 0;
+    calls.grouped = 0;
+    calls.salonNames = 0;
+    calls.counts = 0;
+    calls.max = 0;
+    sweepCalls = 0;
+    sweepPending = null;
+    leadSummaryCache.clear();
+};
+
+(async () => {
+    console.log('booking-request list speed\n');
+
+    await check('a list answers while the expiry sweep is still running', async () => {
+        reset();
+        // A sweep that never settles: before this fix the read awaited it, and
+        // every poll after a burst of leads hung on the bulk UPDATE.
+        sweepPending = new Promise(() => {});
+        const data = await leadService.listSalonLeads({ salonId: 'salon-1', page: 1, limit: 20 });
+        assert.strictEqual(data.requests.length, 1);
+        assert.ok(sweepCalls >= 1, 'the sweep still has to be kicked off');
+    });
+
+    await check('a plain list counts straight off booking_requests', async () => {
+        reset();
+        await leadService.listSalonLeads({ salonId: 'salon-1', page: 1, limit: 20 });
+        const options = calls.pagedQuery[0];
+        assert.strictEqual(options.distinct, undefined);
+        assert.strictEqual(options.subQuery, undefined);
+        // …and the relations are still included, so the rows are complete.
+        assert.strictEqual(options.include.length, 3);
+    });
+
+    await check('only a search pays for the join-aware count', async () => {
+        reset();
+        await leadService.listAdminLeads({ search: 'asha', page: 1, limit: 25 });
+        const options = calls.pagedQuery[0];
+        assert.strictEqual(options.distinct, true);
+        assert.strictEqual(options.subQuery, false);
+    });
+
+    await check('the customer list is scoped and just as cheap', async () => {
+        reset();
+        const data = await leadService.listCustomerLeads({ customerId: 'cust-1', page: 1, limit: 20 });
+        const options = calls.pagedQuery[0];
+        assert.strictEqual(options.where.customerId, 'cust-1');
+        assert.strictEqual(options.distinct, undefined);
+        assert.strictEqual(data.requests[0].salonName, 'Glow Studio');
+    });
+
+    await check('the admin summary is computed once per filter set, not per poll', async () => {
+        reset();
+        const first = await leadService.adminSummary({ range: 'TODAY' });
+        assert.strictEqual(calls.grouped, 1, 'the roll-up runs on a cold cache');
+        const second = await leadService.adminSummary({ range: 'TODAY' });
+        assert.strictEqual(calls.grouped, 1, 'the second call is answered from the cache');
+        assert.deepStrictEqual(second.bySalon, first.bySalon);
+    });
+
+    await check('a different range is a different question', async () => {
+        reset();
+        await leadService.adminSummary({ range: 'TODAY' });
+        await leadService.adminSummary({ range: 'WEEK' });
+        assert.strictEqual(calls.grouped, 2);
+    });
+
+    await check('an answer clears the cached counters immediately', async () => {
+        reset();
+        await leadService.adminSummary({ range: 'TODAY' });
+        leadService.invalidateLeadCaches();
+        await leadService.adminSummary({ range: 'TODAY' });
+        assert.strictEqual(calls.grouped, 2, 'the panel must see the new count after an accept');
+    });
+
+    await check('the indexes are idempotent and built concurrently', () => {
+        const file = read('src/database/config/ensureBookingRequestIndexes.js');
+        const statements = file.match(/CREATE INDEX CONCURRENTLY IF NOT EXISTS[^`]*/g) || [];
+        assert.ok(statements.length >= 3, `expected 3 index statements, found ${statements.length}`);
+        assert.ok(/salon_id, created_at DESC/.test(file));
+        assert.ok(/customer_id, created_at DESC/.test(file));
+        assert.ok(/WHERE responded_at IS NOT NULL/.test(file));
+        // Boot only: never on a read path.
+        assert.ok(/ensureBookingRequestIndexes/.test(read('index.js')));
+        const service = read('src/services/bookingRequestLead.service.js');
+        assert.ok(!/ensureBookingRequestIndexes/.test(service));
+    });
+
+    console.log(`\n${passed} checks passed${process.exitCode ? ' — with failures above' : ''}`);
+    // The pending sweep promise would otherwise keep the event loop alive.
+    process.exit(process.exitCode || 0);
+})().catch((error) => {
+    console.error(error);
+    process.exit(1);
+});
