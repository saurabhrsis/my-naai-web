diff --git a/src/database/config/ensureBookingRequestIndexes.js b/src/database/config/ensureBookingRequestIndexes.js
new file mode 100644
index 0000000..cf1c771
--- /dev/null
+++ b/src/database/config/ensureBookingRequestIndexes.js
@@ -0,0 +1,59 @@
+// The indexes the two booking-request tabs actually ask for.
+//
+// Why at boot, and why `CONCURRENTLY`:
+//
+//   · The lists are ordered `created_at DESC` and filtered by owner
+//     (`salon_id` or `customer_id`). The existing indexes cover
+//     `(salon_id, status, created_at)` — good for "this salon, this status" but
+//     not for "this salon, newest first", which is what the tab opens on — and
+//     `(customer_id, created_at DESC)`, which the customer tab added.
+//   · The admin's per-salon report and the median reply time both scan
+//     `created_at` over rows that have `responded_at`; a partial index on the
+//     answered rows keeps that report from reading the whole table.
+//
+// Every statement is `IF NOT EXISTS`, so this is a no-op on a database that has
+// them, and `CONCURRENTLY` means building one does not block writes to a live
+// `booking_requests` table. It runs once per process at boot (index.js) and never
+// on a read path: an index build must not delay the tab it is meant to speed up.
+// A failure — no CREATE right, an old Postgres, an index still building under the
+// same name — is logged and ignored; the API keeps answering.
+const db = require('../models');
+
+const STATEMENTS = [
+    `CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_booking_requests_salon_created
+        ON booking_requests (salon_id, created_at DESC);`,
+    `CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_booking_requests_customer_created
+        ON booking_requests (customer_id, created_at DESC);`,
+    `CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_booking_requests_answered_created
+        ON booking_requests (created_at)
+        WHERE responded_at IS NOT NULL;`
+];
+
+let started = null;
+
+const ensureBookingRequestIndexes = async ({ force = false } = {}) => {
+    if (started && !force) return started;
+    started = (async () => {
+        const failures = [];
+        for (const statement of STATEMENTS) {
+            try {
+                await db.sequelize.query(statement);
+            } catch (error) {
+                failures.push(error.message);
+            }
+        }
+        if (failures.length) {
+            console.error('[booking-request] could not build every index (the tabs still work, just slower):', failures[0]);
+            return false;
+        }
+        console.log('[booking-request] request indexes present');
+        return true;
+    })();
+
+    return started;
+};
+
+module.exports = {
+    ensureBookingRequestIndexes,
+    BOOKING_REQUEST_INDEX_STATEMENTS: STATEMENTS
+};
