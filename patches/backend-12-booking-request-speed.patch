+/**
+ * The sweep, without making the reader wait for it.
+ *
+ * It used to be `await sweepQuietly()` in front of every list and every summary:
+ * a bulk `UPDATE … RETURNING` (with row locks) ran on the critical path of each
+ * poll, and the API's answer was as slow as the slowest expired-row write. But
+ * the tab does not NEED that write to be correct — every status it shows is
+ * already derived from `expires_at` (`effectiveStatus`, `DERIVED_STATUS_SQL`),
+ * and every status filter already includes "PENDING but past its window". The
+ * sweep is bookkeeping: start it, return the rows.
+ *
+ * `sweepExpiredRequests` is idempotent and throttled (2 s), so a burst of polls
+ * still results in one write, and a failure is logged and forgotten — no reader
+ * ever sees it.
+ */
+const kickSweep = () => {
+    sweepQuietly().catch(() => {});
+};
+
+/**
+ * The summary cache can be emptied from anywhere a request changes.
+ * Cheap enough to call unconditionally (see utils/shortCache.js).
+ */
+const invalidateLeadCaches = () => {
+    leadSummaryCache.clear();
+};
