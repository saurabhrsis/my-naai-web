@@ -0,0 +1,51 @@
+const bookingRequestLeadService = require('../../services/bookingRequestLead.service');
+
+/**
+ * The CUSTOMER's own booking-request history.
+ *
+ * The other half of the salon's Booking requests tab: every request this user
+ * sent, newest first, with what the salon did about it — accepted, rejected, or
+ * nothing at all inside the five-minute window, which the server records as
+ * AUTO_CANCELLED. The client shows it as a read-only tab; nothing here accepts,
+ * rejects or cancels anything.
+ *
+ * Identity comes from the token ONLY (`request.user.id` via authenticateUser).
+ * There is deliberately no `userId` in the body: a body field is a client
+ * choosing whose history to read, and that is not a decision a client gets to
+ * make.
+ *
+ * Body: `{ status?, page?, limit?, fromDate?, toDate? }`
+ */
+const listUserBookingRequests = async (request, response) => {
+    try {
+        const { status, page, limit, fromDate, toDate } = request.body || {};
+        const customerId = request.user?.id;
+
+        if (!customerId) {
+            return response.status(401).json({ status: 'FAILED', message: 'Not authorized' });
+        }
+
+        const data = await bookingRequestLeadService.listCustomerLeads({
+            customerId,
+            status: status || 'ALL',
+            page,
+            limit,
+            fromDate,
+            toDate
+        });
+
+        return response.status(200).json({
+            status: 'SUCCESS',
+            message: 'Booking requests fetched successfully',
+            data
+        });
+    } catch (error) {
+        console.error('LIST USER BOOKING REQUESTS ERROR:', error);
+        return response.status(error.status || 500).json({
+            status: 'FAILED',
+            message: error.message
+        });
+    }
+};
+
+module.exports = listUserBookingRequests;
