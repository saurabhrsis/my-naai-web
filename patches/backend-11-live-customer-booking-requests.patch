diff --git a/scripts/test-booking-request-live.js b/scripts/test-booking-request-live.js
new file mode 100644
index 0000000..0578576
--- /dev/null
+++ b/scripts/test-booking-request-live.js
@@ -0,0 +1,212 @@
+// Live booking requests — the one script that proves the four moving parts.
+//
+//   node scripts/test-booking-request-live.js
+//
+// It runs on a FRESH clone with no `npm ci`: `sequelize` and the model layer are
+// stubbed through `Module._load`, so nothing reaches a database or a network.
+//
+// What it checks:
+//   1. one helper fans a booking-request event out to the salon room, the
+//      customer's room AND the admin room (a new call site cannot forget one);
+//   2. the customer's list is scoped to the caller's own id, carries the salon's
+//      name (the customer knows the salon, not their own name) and derives
+//      AUTO_CANCELLED for a PENDING row whose window has closed;
+//   3. the two wires that make it real are in place: `POST
+//      /api/bookingRequest/user/list` behind authenticateUser, and `join_admin`
+//      putting a panel socket in the `admin` room.
+const assert = require('assert');
+const fs = require('fs');
+const path = require('path');
+const Module = require('module');
+
+const ROOT = path.join(__dirname, '..');
+const read = (relative) => fs.readFileSync(path.join(ROOT, relative), 'utf8');
+
+// ── stubs ───────────────────────────────────────────────────────────────────
+const queries = [];
+const row = {
+    bookingRequestId: 'req-1',
+    customerId: 'cust-1',
+    salonId: 'salon-1',
+    barberId: null,
+    serviceIds: [{ serviceId: 's1', name: 'Haircut', price: 300 }],
+    bookingDate: '2026-11-06',
+    startTime: '18:30:00',
+    endTime: '19:00:00',
+    status: 'PENDING',
+    expiresAt: new Date(Date.now() - 60000), // window already closed
+    createdAt: new Date(Date.now() - 400000),
+    respondedAt: null,
+    bookingId: null,
+    customer: { fullName: 'Asha Rane', phoneNumber: '9876500009' },
+    salon: { salonName: 'Glow Studio', city: 'Nagpur', phoneNumber: '9876500002' },
+    barber: null
+};
+
+const fakeDb = {
+    sequelize: { query: async (sql, options) => { queries.push({ sql, options }); return []; } },
+    BookingRequest: {
+        findAndCountAll: async (options) => {
+            queries.push({ sql: 'findAndCountAll', options });
+            return { count: 1, rows: [row] };
+        },
+        findAll: async () => []
+    },
+    User: {},
+    Salon: {},
+    Barber: {},
+    Service: {}
+};
+
+const fakeSequelize = {
+    Op: { in: 'in', gt: 'gt', gte: 'gte', lt: 'lt', lte: 'lte', iLike: 'iLike', or: 'or', and: 'and' },
+    fn: (...args) => ({ fn: args }),
+    col: (name) => ({ col: name }),
+    literal: (value) => ({ literal: value }),
+    QueryTypes: { SELECT: 'SELECT' }
+};
+
+const originalLoad = Module._load;
+Module._load = function load(request, parent, isMain) {
+    if (request === 'sequelize') return fakeSequelize;
+    if (/database[\\/]models$/.test(request)) return fakeDb;
+    if (/ensureShopSchema$/.test(request)) return { ensureShopSchema: async () => {} };
+    if (/firebase[\\/]sendNotification$/.test(request)) return async () => ({});
+    return originalLoad.apply(this, arguments);
+};
+
+const leadService = require('../src/services/bookingRequestLead.service');
+const {
+    BOOKING_REQUEST_CREATED,
+    BOOKING_REQUEST_UPDATED,
+    bookingRequestEventPayload,
+    emitBookingRequestEvent
+} = require('../src/utils/bookingRequestEvents');
+
+let passed = 0;
+const check = (name, fn) => {
+    try {
+        const result = fn();
+        if (result && typeof result.then === 'function') {
+            return result.then(() => { passed += 1; console.log(`  ✓ ${name}`); })
+                .catch((error) => { console.error(`  ✗ ${name}\n    ${error.message}`); process.exitCode = 1; });
+        }
+        passed += 1;
+        console.log(`  ✓ ${name}`);
+    } catch (error) {
+        console.error(`  ✗ ${name}\n    ${error.message}`);
+        process.exitCode = 1;
+    }
+    return Promise.resolve();
+};
+
+const recorder = () => {
+    const sent = [];
+    const io = {
+        to: (room) => ({ emit: (event, body) => sent.push({ room, event, body }) })
+    };
+    return { io, sent };
+};
+
+(async () => {
+    console.log('booking-request live events\n');
+
+    // 1 ── fan-out ───────────────────────────────────────────────────────────
+    await check('a created event reaches the salon, the customer and the admin room', () => {
+        const { io, sent } = recorder();
+        emitBookingRequestEvent(io, BOOKING_REQUEST_CREATED, {
+            bookingRequestId: 'req-1', salonId: 'salon-1', customerId: 'cust-1', customerName: 'Asha Rane'
+        });
+        assert.deepStrictEqual(sent.map((item) => item.room), ['salon_salon-1', 'user_cust-1', 'admin']);
+        assert.ok(sent.every((item) => item.event === BOOKING_REQUEST_CREATED));
+        assert.strictEqual(sent[0].body.customerName, 'Asha Rane');
+        // The payload is a label, not a record: no service list, no phone number.
+        assert.deepStrictEqual(Object.keys(sent[0].body).sort(), [
+            'bookingDate', 'bookingRequestId', 'bookingTime', 'createdAt', 'customerId',
+            'customerName', 'expiresAt', 'salonId', 'salonName', 'status'
+        ]);
+    });
+
+    await check('an admin-only event still reaches the panel when there is no salon or customer', () => {
+        const { io, sent } = recorder();
+        emitBookingRequestEvent(io, BOOKING_REQUEST_UPDATED, { bookingRequestId: 'req-2' });
+        assert.deepStrictEqual(sent.map((item) => item.room), ['admin']);
+    });
+
+    await check('a dead socket never breaks the write that caused it', () => {
+        const broken = { to: () => { throw new Error('socket closed'); } };
+        const originalError = console.error;
+        console.error = () => {};
+        try {
+            assert.doesNotThrow(() => emitBookingRequestEvent(broken, BOOKING_REQUEST_UPDATED, { salonId: 's' }));
+        } finally {
+            console.error = originalError;
+        }
+        // …and a missing io is a no-op, not a crash.
+        assert.doesNotThrow(() => emitBookingRequestEvent(null, BOOKING_REQUEST_UPDATED, { salonId: 's' }));
+    });
+
+    await check('the payload builder reads the row it was given', () => {
+        const payload = bookingRequestEventPayload(row, { customerName: 'Asha Rane' });
+        assert.strictEqual(payload.bookingRequestId, 'req-1');
+        assert.strictEqual(payload.bookingTime, '18:30:00'); // startTime, not bookingTime
+        assert.strictEqual(payload.salonId, 'salon-1');
+        assert.strictEqual(payload.customerName, 'Asha Rane');
+    });
+
+    // 2 ── the customer's list ───────────────────────────────────────────────
+    await check('the customer list is scoped to the caller and names the salon', async () => {
+        queries.length = 0;
+        const data = await leadService.listCustomerLeads({ customerId: 'cust-1', page: 1, limit: 20 });
+        const call = queries.find((item) => item.sql === 'findAndCountAll');
+        assert.ok(call, 'the list has to query booking_requests');
+        assert.strictEqual(call.options.where.customerId, 'cust-1');
+        assert.strictEqual(data.requests.length, 1);
+        assert.strictEqual(data.requests[0].salonName, 'Glow Studio');
+        assert.strictEqual(data.requests[0].salonCity, 'Nagpur');
+        assert.strictEqual(data.requests[0].customerName, 'Asha Rane');
+        // The salon's own columns are not in the customer's payload.
+        assert.strictEqual(data.requests[0].answeredByRole, undefined);
+        assert.strictEqual(data.requests[0].outcome, undefined);
+    });
+
+    await check('an expired PENDING row reads as AUTO_CANCELLED, never as a rejection', async () => {
+        queries.length = 0;
+        const data = await leadService.listCustomerLeads({ customerId: 'cust-1' });
+        assert.strictEqual(data.requests[0].status, 'AUTO_CANCELLED');
+        assert.strictEqual(data.requests[0].rawStatus, 'PENDING');
+    });
+
+    await check('a customer list without an identity is refused, not widened', async () => {
+        await assert.rejects(() => leadService.listCustomerLeads({}), /Not authorized/);
+    });
+
+    // 3 ── the wires ─────────────────────────────────────────────────────────
+    await check('POST /api/bookingRequest/user/list is behind authenticateUser', () => {
+        const routes = read('src/routes/bookingRequest.routes.js');
+        assert.ok(/bookingRequestRouter\.post\('\/user\/list',\s*authenticateUser/.test(routes),
+            'the route must sit behind the customer token');
+    });
+
+    await check('the panel can join the admin room', () => {
+        const index = read('index.js');
+        assert.ok(/socket\.on\("join_admin"/.test(index), 'join_admin listener missing');
+        assert.ok(/socket\.join\("admin"\)/.test(index), 'the socket must actually join `admin`');
+    });
+
+    await check('every answer path emits an update', () => {
+        const actions = read('src/services/bookingRequestAction.service.js');
+        const occurrences = actions.match(/emitBookingRequestEvent\(io, BOOKING_REQUEST_UPDATED/g) || [];
+        // ACCEPT, REJECT, DELAY and the expired-during-answer refusal.
+        assert.ok(occurrences.length >= 4, `expected 4 update emits, found ${occurrences.length}`);
+        const autoCancel = read('src/controller/bookingRequest/autoCancelBookingRequest.js');
+        assert.ok(/emitBookingRequestEvent\(req\.io, BOOKING_REQUEST_UPDATED/.test(autoCancel));
+        const create = read('src/controller/bookingRequest/bookingRequest.js');
+        assert.ok(/emitBookingRequestEvent\(req\.io, BOOKING_REQUEST_CREATED/.test(create));
+    });
+
+    console.log(`\n${passed} checks passed${process.exitCode ? ' — with failures above' : ''}`);
+})().catch((error) => {
+    console.error(error);
+    process.exit(1);
+});
