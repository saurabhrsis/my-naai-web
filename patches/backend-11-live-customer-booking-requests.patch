+// Live booking-request events.
+//
+// Three screens have to know about a request the moment it moves: the salon's
+// Booking requests tab (so a customer's request appears without a refresh), the
+// admin panel (the same page, for every salon) and the customer's own request
+// history (the countdown has to stop when it is answered). One helper emits to
+// all three rooms so a new call site cannot reach two of them and forget the
+// third.
+//
+// The payload is a label, not a record: ids plus a few strings the client can
+// say out loud. Every screen still reads the rows it shows from its own
+// authenticated endpoint — an event says "something changed", never "here is
+// the truth". That is what keeps a socket message from being able to invent a
+// request that the database does not have.
+const BOOKING_REQUEST_CREATED = 'booking_request_created';
+const BOOKING_REQUEST_UPDATED = 'booking_request_updated';
+
+// `admin` is the panel-wide room (index.js joins it on `join_admin`); the other
+// two are per-identity rooms that already existed.
+const roomsFor = (payload = {}) => {
+    const rooms = [];
+    if (payload.salonId) rooms.push(`salon_${payload.salonId}`);
+    if (payload.customerId) rooms.push(`user_${payload.customerId}`);
+    rooms.push('admin');
+    return [...new Set(rooms)];
+};
+
+const emitBookingRequestEvent = (io, event, payload = {}) => {
+    if (!io || typeof io.to !== 'function') return;
+    const body = {
+        bookingRequestId: payload.bookingRequestId || null,
+        salonId: payload.salonId || null,
+        salonName: payload.salonName || '',
+        customerId: payload.customerId || null,
+        customerName: payload.customerName || '',
+        bookingDate: payload.bookingDate || null,
+        bookingTime: payload.bookingTime || null,
+        status: payload.status || null,
+        createdAt: payload.createdAt || null,
+        expiresAt: payload.expiresAt || null
+    };
+
+    for (const room of roomsFor(payload)) {
+        try {
+            io.to(room).emit(event, body);
+        } catch (error) {
+            // A dead socket must never break the write that caused it.
+            console.error(`[booking-request] could not emit ${event} to ${room}:`, error.message);
+        }
+    }
+};
+
+// `bookingRequest` is a Sequelize instance (or a plain object) from
+// `booking_requests`; the extra fields are the ones the row does not carry
+// (the customer's name, the salon's name).
+const bookingRequestEventPayload = (bookingRequest = {}, extra = {}) => ({
+    bookingRequestId: bookingRequest.bookingRequestId,
+    salonId: bookingRequest.salonId,
+    customerId: bookingRequest.customerId,
+    bookingDate: bookingRequest.bookingDate,
+    bookingTime: bookingRequest.startTime || bookingRequest.bookingTime,
+    status: bookingRequest.status,
+    createdAt: bookingRequest.createdAt,
+    expiresAt: bookingRequest.expiresAt,
+    ...extra
+});
+
+module.exports = {
+    BOOKING_REQUEST_CREATED,
+    BOOKING_REQUEST_UPDATED,
+    bookingRequestEventPayload,
+    emitBookingRequestEvent
+};
