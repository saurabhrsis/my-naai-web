@@ -0,0 +1,105 @@
+#!/usr/bin/env node
+// scripts/check-firebase-credentials.js
+//
+// "Error sending push notification: … invalid_grant: Invalid JWT Signature" —
+// which of the two causes is it, on THIS server?
+//
+//   npm run firebase:check                 # what is configured, and can it sign?
+//   npm run firebase:check -- --online     # ask Google: is this key still published?
+//   npm run firebase:check -- --send <token>   # …and send one real push
+//
+// Exit code 0 means push can work; anything else prints the fix.
+'use strict';
+
+const { loadServiceAccount, describeServiceAccount } = require('../src/firebase/credentials');
+const { explainCredentialFailure, signProbeJwt, formatDiagnosis } = require('../src/firebase/credentialsDoctor');
+
+const args = process.argv.slice(2);
+const online = args.includes('--online') || args.includes('--send');
+const sendIndex = args.indexOf('--send');
+const sendToken = sendIndex >= 0 ? args[sendIndex + 1] : '';
+
+const label = (value) => (value ? value : '(not set)');
+
+async function main() {
+    console.log('Firebase push credential check\n');
+
+    let loaded;
+    try {
+        loaded = loadServiceAccount();
+    } catch (error) {
+        console.error(`❌ ${error.message}`);
+        if (error.hint) console.error(`   ${error.hint}`);
+        console.error('\nConfigure FIREBASE_SERVICE_ACCOUNT_JSON (or FIREBASE_SERVICE_ACCOUNT_PATH) with a key from');
+        console.error('Firebase → Project settings → Service accounts → Generate new private key.');
+        return 1;
+    }
+
+    const facts = describeServiceAccount(loaded.serviceAccount, loaded.source);
+    console.log(`✅ credential found — ${loaded.source}`);
+    console.log(`   project          ${label(facts.projectId)}`);
+    console.log(`   client_email     ${label(facts.clientEmail)}`);
+    console.log(`   private_key_id   ${label(facts.privateKeyId)}`);
+    console.log(`   key              ${facts.keyType || 'unknown'} ${facts.keyBits || ''} · fingerprint ${facts.keyFingerprint}`);
+    console.log(`   token_uri        ${facts.tokenUri}`);
+    for (const warning of facts.warnings) console.log(`   ⚠️  ${warning}`);
+
+    // Local: can this key sign at all?
+    let signed;
+    try {
+        signed = signProbeJwt(loaded.serviceAccount);
+        console.log('✅ the key signs an RS256 token locally (the PEM is intact)');
+    } catch (error) {
+        console.error(`❌ the key cannot sign: ${error.message}`);
+        console.error('   Replace the whole JSON with a fresh download.');
+        return 2;
+    }
+
+    if (!online) {
+        console.log('\nNext: npm run firebase:check -- --online   (asks Google whether this key id is still published)');
+        return 0;
+    }
+
+    console.log('\nAsking Google whether this key is still published…');
+    const verdict = await explainCredentialFailure(loaded.serviceAccount, { timeoutMs: 10000, source: loaded.source });
+    console.log(`\n${verdict.verdict}`);
+    console.log(formatDiagnosis(verdict));
+
+    if (verdict.verdict !== 'credentials-look-valid' && !/clock-skew$/.test(verdict.verdict)) {
+        return 3;
+    }
+
+    if (sendToken) {
+        console.log(`\nSending one real push to ${String(sendToken).slice(0, 6)}…${String(sendToken).slice(-4)}…`);
+        // Required here, not at the top: the send path builds the admin app,
+        // which is exactly what fails when the credential is wrong.
+        const admin = require('firebase-admin');
+        try {
+            const app = admin.apps.length ? admin.app() : admin.initializeApp({
+                credential: admin.credential.cert(loaded.serviceAccount),
+            });
+            const messageId = await app.messaging().send({
+                data: { title: 'My Naai test', body: 'Push is working on this server.', type: 'TEST', name: 'MyNaai' },
+                android: { priority: 'high' },
+                token: sendToken,
+            });
+            console.log(`✅ sent — message id ${messageId}`);
+        } catch (error) {
+            console.error(`❌ the send failed: ${error.code || error.message}`);
+            const hint = /registration-token-not-registered|invalid-registration-token/.test(String(error.code))
+                ? 'That device token is dead, not the credential. Try a token from a phone that has the app open.'
+                : 'If this is app/invalid-credential, the credential is fine but the server cannot reach oauth2.googleapis.com — check egress.';
+            console.error(`   ${hint}`);
+            return 4;
+        }
+    }
+
+    return 0;
+}
+
+main()
+    .then((code) => process.exit(code))
+    .catch((error) => {
+        console.error(`❌ check failed: ${error.message}`);
+        process.exit(5);
+    });
diff --git a/scripts/test-firebase-credentials.js b/scripts/test-firebase-credentials.js
new file mode 100644
index 0000000..c51abb0
--- /dev/null
+++ b/scripts/test-firebase-credentials.js
@@ -0,0 +1,356 @@
+#!/usr/bin/env node
+// scripts/test-firebase-credentials.js
+//
+// No network, no database, no Firebase project: every case below is built from
+// a throwaway RSA key generated here, and the two services the code talks to
+// (firebase-admin and Sequelize models) are stubbed.
+//
+//   node scripts/test-firebase-credentials.js
+'use strict';
+
+const Module = require('module');
+const crypto = require('crypto');
+const os = require('os');
+const fs = require('fs');
+const path = require('path');
+
+let passed = 0;
+let failed = 0;
+const check = (name, condition, detail = '') => {
+    if (condition) {
+        passed += 1;
+        console.log(`  ✓ ${name}`);
+    } else {
+        failed += 1;
+        console.log(`  ✗ ${name}${detail ? `\n    ${detail}` : ''}`);
+    }
+};
+
+// ── a throwaway keypair, so "a key that signs" and "a key Google published"
+//    can be the same key or different keys on purpose ─────────────────────────
+const keyPair = () => {
+    const { privateKey, publicKey } = crypto.generateKeyPairSync('rsa', { modulusLength: 2048 });
+    return {
+        privatePem: privateKey.export({ type: 'pkcs8', format: 'pem' }),
+        certificate: publicKey.export({ type: 'spki', format: 'pem' }),
+    };
+};
+
+const KEY_A = keyPair();
+const KEY_B = keyPair();
+
+const serviceAccount = (overrides = {}) => ({
+    type: 'service_account',
+    project_id: 'mynaai-demo',
+    private_key_id: 'kid-aaa',
+    private_key: KEY_A.privatePem,
+    client_email: 'firebase-adminsdk-fbsvc@mynaai-demo.iam.gserviceaccount.com',
+    client_id: '104740547298300002183',
+    token_uri: 'https://oauth2.googleapis.com/token',
+    ...overrides,
+});
+
+const {
+    normalizePrivateKey,
+    parseServiceAccountText,
+    validateServiceAccount,
+    describeServiceAccount,
+    loadServiceAccount,
+    CredentialConfigError,
+} = require('../src/firebase/credentials');
+const {
+    classifyError,
+    explainCredentialFailure,
+    formatDiagnosis,
+    signProbeJwt,
+    verifyProbe,
+} = require('../src/firebase/credentialsDoctor');
+
+// ── 1. the shapes a key actually arrives in ──────────────────────────────────
+console.log('credential shapes');
+
+const escaped = KEY_A.privatePem.replace(/\n/g, '\\n');
+check(
+    'a .env value with literal \\n becomes a parseable PEM',
+    (() => { try { crypto.createPrivateKey(normalizePrivateKey(escaped)); return true; } catch { return false; } })()
+);
+const doubleEscaped = KEY_A.privatePem.replace(/\n/g, '\\\\n');
+check(
+    'a value escaped twice (\\\\n) also becomes a parseable PEM',
+    (() => { try { crypto.createPrivateKey(normalizePrivateKey(doubleEscaped)); return true; } catch { return false; } })()
+);
+check(
+    'quoted, indented, space-split key bodies are repaired',
+    (() => {
+        const mangled = `"${KEY_A.privatePem.replace(/\n/g, '  \n    ').trim()}"`;
+        try { crypto.createPrivateKey(normalizePrivateKey(mangled)); return true; } catch { return false; }
+    })()
+);
+check(
+    'the normalized key is the same key (not a re-wrap that lost bytes)',
+    crypto.createPublicKey(normalizePrivateKey(escaped)).export({ type: 'spki', format: 'pem' }) ===
+    crypto.createPublicKey(KEY_A.privatePem).export({ type: 'spki', format: 'pem' })
+);
+
+check('plain JSON parses', parseServiceAccountText(JSON.stringify(serviceAccount())).project_id === 'mynaai-demo');
+check(
+    'escaped JSON ({"type":\\"service_account\\"…}) parses',
+    parseServiceAccountText(JSON.stringify(serviceAccount()).replace(/"/g, '\\"')).project_id === 'mynaai-demo'
+);
+check(
+    'base64 of the JSON parses',
+    parseServiceAccountText(Buffer.from(JSON.stringify(serviceAccount()), 'utf8').toString('base64')).project_id === 'mynaai-demo'
+);
+check(
+    'a bare private key is refused with an explanation, not a JSON parse error',
+    (() => {
+        try { parseServiceAccountText(KEY_A.privatePem); return false; } catch (error) {
+            return error instanceof CredentialConfigError && error.code === 'private-key-only' && /entire service-account JSON/.test(error.hint);
+        }
+    })()
+);
+check('an empty value is refused', (() => {
+    try { parseServiceAccountText('  '); return false; } catch (error) { return error.code === 'empty'; }
+})());
+
+// ── 2. validation says what is wrong, in words an operator can act on ────────
+console.log('\nvalidation');
+
+check('a good service account validates', validateServiceAccount(serviceAccount()).ok);
+check(
+    'a missing private_key is reported as a missing field',
+    validateServiceAccount(serviceAccount({ private_key: '' })).errors.some((item) => item.code === 'missing-field')
+);
+check(
+    'a placeholder key is caught before Google sees it',
+    validateServiceAccount(serviceAccount({ private_key: 'YOUR_PRIVATE_KEY_HERE' })).errors.some((item) => item.code === 'placeholder-key' || item.code === 'unparsable-key')
+);
+check(
+    'a truncated key is caught, with the "paste the whole JSON" hint',
+    (() => {
+        const broken = String(KEY_A.privatePem).split('\n').slice(0, 4).join('\n');
+        const result = validateServiceAccount(serviceAccount({ private_key: broken }));
+        return !result.ok && /newlines|truncated/i.test(result.errors.map((item) => item.hint).join(' '));
+    })()
+);
+check(
+    'a non-RSA key is refused (Google signs RS256)',
+    (() => {
+        const ec = crypto.generateKeyPairSync('ec', { namedCurve: 'prime256v1' }).privateKey.export({ type: 'pkcs8', format: 'pem' });
+        return validateServiceAccount(serviceAccount({ private_key: ec })).errors.some((item) => item.code === 'not-rsa');
+    })()
+);
+check(
+    'a key from a different project than client_email is called out',
+    (() => {
+        const result = validateServiceAccount(serviceAccount({ project_id: 'another-project' }));
+        return result.warnings.some((line) => /belongs to project "mynaai-demo"/.test(line));
+    })()
+);
+check(
+    'the committed key file is called out as public',
+    validateServiceAccount(serviceAccount(), '/repo/src/firebase/myNaai-firebase.json').warnings
+        .some((line) => /committed to the repository/.test(line))
+);
+check(
+    'nothing printed about a credential contains the private key',
+    (() => {
+        const described = JSON.stringify(describeServiceAccount(serviceAccount(), 'env FIREBASE_SERVICE_ACCOUNT_JSON'));
+        return !described.includes('BEGIN PRIVATE KEY') && described.includes('keyFingerprint') && described.facts === undefined;
+    })()
+);
+
+// ── 3. resolution order ──────────────────────────────────────────────────────
+console.log('\nresolution');
+
+const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'firebase-credentials-'));
+const filePath = path.join(tmpDir, 'service-account.json');
+fs.writeFileSync(filePath, JSON.stringify(serviceAccount()), 'utf8');
+
+check(
+    'FIREBASE_SERVICE_ACCOUNT_JSON wins over everything',
+    loadServiceAccount({ env: { FIREBASE_SERVICE_ACCOUNT_JSON: JSON.stringify(serviceAccount()), FIREBASE_SERVICE_ACCOUNT_PATH: filePath }, includeRepoFile: false }).source === 'env FIREBASE_SERVICE_ACCOUNT_JSON'
+);
+check(
+    'FIREBASE_SERVICE_ACCOUNT_PATH is read',
+    loadServiceAccount({ env: { FIREBASE_SERVICE_ACCOUNT_PATH: filePath }, includeRepoFile: false }).source === filePath
+);
+check(
+    'the three legacy variables still work',
+    (() => {
+        const loaded = loadServiceAccount({
+            env: {
+                FIREBASE_PROJECT_ID: 'mynaai-demo',
+                FIREBASE_CLIENT_EMAIL: 'firebase-adminsdk-fbsvc@mynaai-demo.iam.gserviceaccount.com',
+                FIREBASE_PRIVATE_KEY: escaped,
+            },
+            includeRepoFile: false,
+        });
+        return loaded.source === 'env FIREBASE_PRIVATE_KEY' && loaded.serviceAccount.private_key.includes('BEGIN PRIVATE KEY');
+    })()
+);
+check(
+    'a broken env value is reported instead of silently falling back',
+    (() => {
+        try { loadServiceAccount({ env: { FIREBASE_SERVICE_ACCOUNT_JSON: '{ not json' }, includeRepoFile: true }); return false; }
+        catch (error) { return error.code === 'not-json' && /FIREBASE_SERVICE_ACCOUNT_JSON/.test(error.message); }
+    })()
+);
+check(
+    'nothing configured is a clear message, not a stack trace',
+    (() => {
+        try { loadServiceAccount({ env: {}, includeRepoFile: false }); return false; }
+        catch (error) { return error instanceof CredentialConfigError && /FIREBASE_SERVICE_ACCOUNT_JSON/.test(error.hint); }
+    })()
+);
+
+// ── 4. what a failure means ──────────────────────────────────────────────────
+console.log('\nclassification');
+
+const firebaseError = (code, message = '') => Object.assign(new Error(message || code), { code });
+check('app/invalid-credential is a credential failure', classifyError(firebaseError('app/invalid-credential')) === 'credential');
+check(
+    'invalid_grant / Invalid JWT Signature is a credential failure even without the code',
+    classifyError(firebaseError('', 'invalid_grant: Invalid JWT Signature.')) === 'credential'
+);
+check(
+    'a dead token is a token failure',
+    classifyError(firebaseError('messaging/registration-token-not-registered')) === 'token'
+);
+check(
+    'messaging/invalid-argument is only about the token when the message says token',
+    classifyError(firebaseError('messaging/invalid-argument', 'The registration token is not a valid FCM registration token')) === 'token' &&
+    classifyError(firebaseError('messaging/invalid-argument', 'data payload must be strings')) === 'message'
+);
+check('a 503 from FCM is transient', classifyError(firebaseError('messaging/server-unavailable')) === 'transient');
+
+// ── 5. the diagnosis itself ──────────────────────────────────────────────────
+console.log('\ndiagnosis');
+
+const certsFor = (keyId, certificatePem, { skewSeconds = 0 } = {}) => async () => ({
+    certificates: { [keyId]: certificatePem },
+    serverTime: Date.now() - skewSeconds * 1000,
+});
+
+(async () => {
+    const revoked = await explainCredentialFailure(serviceAccount(), { fetchCertificates: certsFor('something-else', KEY_A.certificate) });
+    check('a key id Google does not publish is reported as revoked', revoked.verdict === 'key-revoked', revoked.verdict);
+    check('…and the fix starts with generating a new key', /Generate new private key/.test(revoked.steps[0]));
+
+    const mismatched = await explainCredentialFailure(serviceAccount(), { fetchCertificates: certsFor('kid-aaa', KEY_B.certificate) });
+    check('a key that does not match its key id is reported as a mismatch', mismatched.verdict === 'key-mismatch', mismatched.verdict);
+
+    const valid = await explainCredentialFailure(serviceAccount(), { fetchCertificates: certsFor('kid-aaa', KEY_A.certificate) });
+    check('the right key is reported as valid', valid.verdict === 'credentials-look-valid', valid.verdict);
+
+    const skewed = await explainCredentialFailure(serviceAccount(), {
+        fetchCertificates: certsFor('kid-aaa', KEY_A.certificate, { skewSeconds: 900 }),
+    });
+    check('a clock 15 minutes off is reported as clock skew', skewed.verdict === 'clock-skew', skewed.verdict);
+    check('…with the number of seconds in the summary', /15 min|900 s/.test(skewed.summary), skewed.summary);
+
+    const both = await explainCredentialFailure(serviceAccount(), {
+        fetchCertificates: certsFor('gone', KEY_A.certificate, { skewSeconds: 900 }),
+    });
+    check('clock skew AND a revoked key are reported together', both.verdict === 'clock-skew-and-key-revoked', both.verdict);
+
+    const offline = await explainCredentialFailure(serviceAccount(), {
+        fetchCertificates: async () => { throw new Error('getaddrinfo EAI_AGAIN www.googleapis.com'); },
+    });
+    check('no egress is its own verdict, not a guess', offline.verdict === 'cannot-check-online');
+
+    const unusable = await explainCredentialFailure(serviceAccount({ private_key: 'not a key' }), {
+        fetchCertificates: certsFor('kid-aaa', KEY_A.certificate),
+    });
+    check('an unusable key never reaches the network verdict', unusable.verdict === 'key-unusable');
+
+    check(
+        'the printed diagnosis names the project, the key id and the source — never the key',
+        (() => {
+            const text = formatDiagnosis(revoked);
+            return text.includes('mynaai-demo') && text.includes('kid-aaa') && !text.includes('BEGIN PRIVATE KEY');
+        })()
+    );
+
+    const signed = signProbeJwt(serviceAccount());
+    check('the probe token is RS256 with the key id in its header', (() => {
+        const header = JSON.parse(Buffer.from(signed.signingInput.split('.')[0], 'base64').toString('utf8'));
+        return header.alg === 'RS256' && header.kid === 'kid-aaa';
+    })());
+    check('the probe verifies against the matching certificate', verifyProbe(signed, KEY_A.certificate));
+    check('the probe does not verify against a different certificate', !verifyProbe(signed, KEY_B.certificate));
+
+    // ── 6. the sender: never throws, never kills a token over a server fault ───
+    console.log('\nsender');
+
+    const dbCalls = { deactivated: [] };
+    const stubs = {
+        '../database/models': {
+            DeviceToken: { update: async (_values, options) => { dbCalls.deactivated.push(options.where.deviceToken); return [1]; } },
+        },
+        './firebase': {
+            messaging: () => ({ send: async () => 'projects/mynaai-demo/messages/1' }),
+            serviceAccount: serviceAccount(),
+            status: () => ({}),
+        },
+    };
+    const originalLoad = Module._load;
+    Module._load = function patched(request, parent, isMain) {
+        if (Object.prototype.hasOwnProperty.call(stubs, request)) return stubs[request];
+        return originalLoad.call(this, request, parent, isMain);
+    };
+    // The sender requires its collaborators by relative path.
+    const sendPath = require.resolve('../src/firebase/sendNotification');
+    delete require.cache[sendPath];
+    const send = require('../src/firebase/sendNotification');
+    Module._load = originalLoad;
+
+    const sent = await send('token-abcdefghijklmnop', 'Hi', 'There', { type: 'TEST' });
+    check('a delivered push reports ok', sent.ok === true && sent.messageId.includes('messages/1'));
+    check('the sent log line masks the token', send.maskToken('token-abcdefghijklmnop') === 'token-…mnop');
+
+    // firebase stubbed to fail exactly the way production failed
+    const failWith = (error) => { stubs['./firebase'].messaging = () => ({ send: async () => { throw error; } }); };
+    const reload = () => {
+        Module._load = function patched(request, parent, isMain) {
+            if (Object.prototype.hasOwnProperty.call(stubs, request)) return stubs[request];
+            return originalLoad.call(this, request, parent, isMain);
+        };
+        delete require.cache[sendPath];
+        const fresh = require('../src/firebase/sendNotification');
+        Module._load = originalLoad;
+        return fresh;
+    };
+
+    const credentialError = Object.assign(new Error('Credential implementation provided to initializeApp() … "invalid_grant: Invalid JWT Signature."'), { code: 'app/invalid-credential' });
+    failWith(credentialError);
+    const senderWithBadCredential = reload();
+    const bad = await senderWithBadCredential('token-abcdefghijklmnop', 'Hi', 'There', { type: 'TEST' });
+    check('the reported production error does not throw at the caller', bad.ok === false && bad.kind === 'credential');
+    check('a credential failure never deactivates a device token', dbCalls.deactivated.length === 0);
+    check('a credential failure suspends push instead of hammering Google', senderWithBadCredential.isPushSuspended());
+    const skipped = await senderWithBadCredential('another-token', 'Hi', 'There');
+    check('while suspended, further sends are skipped cheaply', skipped.skipped === true && skipped.reason === 'push-suspended');
+
+    failWith(Object.assign(new Error('Requested entity was not found.'), { code: 'messaging/registration-token-not-registered' }));
+    const tokenSender = reload();
+    const dead = await tokenSender('dead-token-000000000', 'Hi', 'There');
+    check('a registration-token-not-registered error deactivates that token', dead.kind === 'token' && dbCalls.deactivated.includes('dead-token-000000000'));
+
+    let attempts = 0;
+    stubs['./firebase'].messaging = () => ({
+        send: async () => {
+            attempts += 1;
+            if (attempts === 1) throw Object.assign(new Error('backend unavailable'), { code: 'messaging/server-unavailable' });
+            return 'ok-after-retry';
+        },
+    });
+    const retrySender = reload();
+    const retried = await retrySender('retry-token-00000000', 'Hi', 'There');
+    check('a transient failure is retried once and then succeeds', retried.ok === true && attempts === 2);
+
+    await new Promise((resolve) => setTimeout(resolve, 600)); // let retry timers finish
+    fs.rmSync(tmpDir, { recursive: true, force: true });
+    console.log(`\n${passed} checks passed${failed ? ` — ${failed} FAILED` : ''}`);
+    process.exit(failed ? 1 : 0);
+})();
