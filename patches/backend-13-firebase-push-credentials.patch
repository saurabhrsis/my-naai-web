index 0000000..b72f428
--- /dev/null
+++ b/src/firebase/credentialsDoctor.js
@@ -0,0 +1,287 @@
+// src/firebase/credentialsDoctor.js
+//
+// "Invalid JWT Signature" has exactly three causes worth distinguishing, and
+// Google's own error message lists two of them without saying which applies to
+// you:
+//
+//   · the key was deleted or revoked in the console  → the key id is no longer
+//     published, and there is no way for the signature to verify;
+//   · the private_key does not belong to the private_key_id in the same file
+//     → two keys were mixed (or one was edited/truncated while it was copied);
+//   · the server's clock is off by minutes → the token's `iat` is not yet valid
+//     or already expired, and Google rejects it before the signature matters.
+//
+// This module tells them apart without sending a single push: it signs a probe
+// JWT with the configured key and verifies it against the public certificate
+// Google publishes for that key id, and it compares the local clock with
+// Google's.
+'use strict';
+
+const crypto = require('crypto');
+const https = require('https');
+const { describeServiceAccount } = require('./credentials');
+
+const CREDENTIAL_CODES = new Set([
+    'app/invalid-credential',
+    'app/invalid-app-credential',
+    'app/credential-created-without-error',
+    'auth/invalid-credential',
+    'auth/invalid-grant',
+]);
+
+const TOKEN_CODES = new Set([
+    'messaging/registration-token-not-registered',
+    'messaging/invalid-registration-token',
+    'messaging/mismatched-credential',
+]);
+
+const TRANSIENT_CODES = new Set([
+    'messaging/internal-error',
+    'messaging/server-unavailable',
+    'messaging/unknown',
+    'messaging/quota-exceeded',
+    'messaging/message-rate-exceeded',
+    'messaging/third-party-auth-error',
+    'app/network-error',
+    'app/network-timeout',
+    'ETIMEDOUT',
+    'ECONNRESET',
+    'ENOTFOUND',
+    'EAI_AGAIN',
+]);
+
+/**
+ * What kind of failure is this?
+ *
+ * `credential` — the server cannot authenticate to Google at all. Retrying,
+ *   and deactivating device tokens, are both wrong.
+ * `token`      — this device's token is dead. It may be deactivated.
+ * `message`    — the payload was refused. The token may still be fine.
+ * `transient`  — worth one retry.
+ */
+function classifyError(error) {
+    const code = String((error && (error.code || (error.errorInfo && error.errorInfo.code))) || '');
+    const message = String((error && (error.message || (error.errorInfo && error.errorInfo.message))) || '');
+
+    if (CREDENTIAL_CODES.has(code)) return 'credential';
+    if (/invalid_grant/i.test(message) || /Invalid JWT Signature/i.test(message)) return 'credential';
+    if (/(credential|service account)/i.test(message) && /(invalid|failed|unable)/i.test(message) && !/token/i.test(message)) {
+        return 'credential';
+    }
+    if (TOKEN_CODES.has(code)) return 'token';
+    if (code === 'messaging/invalid-argument') {
+        // The same code covers "this token is malformed" and "this message is
+        // malformed". Only the first is about the device.
+        return /token/i.test(message) ? 'token' : 'message';
+    }
+    if (TRANSIENT_CODES.has(code)) return 'transient';
+    return 'other';
+}
+
+const base64url = (value) => Buffer.from(value).toString('base64').replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+
+/**
+ * Sign the JWT Google would receive from firebase-admin (`RS256`, `kid` in the
+ * header), so it can be checked locally against Google's public certificate.
+ */
+function signProbeJwt(serviceAccount, nowMs = Date.now()) {
+    const now = Math.floor(nowMs / 1000);
+    const header = { alg: 'RS256', typ: 'JWT', kid: serviceAccount.private_key_id || undefined };
+    const payload = {
+        iss: serviceAccount.client_email,
+        scope: 'https://www.googleapis.com/auth/firebase.messaging',
+        aud: serviceAccount.token_uri || 'https://oauth2.googleapis.com/token',
+        iat: now,
+        exp: now + 3600,
+    };
+    const signingInput = `${base64url(JSON.stringify(header))}.${base64url(JSON.stringify(payload))}`;
+    const signature = crypto.sign('RSA-SHA256', Buffer.from(signingInput), serviceAccount.private_key);
+    return { signingInput, signature };
+}
+
+function verifyProbe(signed, certificatePem) {
+    try {
+        return crypto.verify('RSA-SHA256', Buffer.from(signed.signingInput), certificatePem, signed.signature);
+    } catch {
+        return false;
+    }
+}
+
+/** The public certificates Google publishes for one service account. */
+function fetchGoogleCertificates(serviceAccount, timeoutMs = 8000) {
+    const url = `https://www.googleapis.com/robot/v1/metadata/x509/${encodeURIComponent(serviceAccount.client_email)}`;
+    return new Promise((resolve, reject) => {
+        const request = https.get(url, { timeout: timeoutMs }, (response) => {
+            let body = '';
+            response.setEncoding('utf8');
+            response.on('data', (chunk) => { body += chunk; });
+            response.on('end', () => {
+                if (response.statusCode !== 200) {
+                    reject(new Error(`Google answered ${response.statusCode} for the certificate list`));
+                    return;
+                }
+                let certificates;
+                try {
+                    certificates = JSON.parse(body);
