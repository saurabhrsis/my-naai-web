+        `  key fingerprint: ${facts.keyFingerprint || '(none)'} · source: ${facts.source || '(unknown)'}`,
+        '  fix:',
+        ...verdict.steps.map((step) => `    · ${step}`),
+        '  check the server yourself with: npm run firebase:check -- --online',
+    ];
+    return lines.join('\n');
