+    if (certificate) {
+        const verified = verifyProbe(signed, certificate);
+        if (verified) {
+            verdict.verdict = Math.abs(verdict.clockSkewSeconds || 0) > 120 ? 'clock-skew' : 'credentials-look-valid';
