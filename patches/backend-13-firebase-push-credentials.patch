+    let published;
+    try {
+        published = await fetchCertificates(serviceAccount, timeoutMs);
+    } catch (error) {
+        verdict.verdict = 'cannot-check-online';
+        verdict.summary = SUMMARY['cannot-check-online'](facts, { error: error.message });
+        verdict.steps = FIX_STEPS['cannot-check-online'];
+        return verdict;
+    }
