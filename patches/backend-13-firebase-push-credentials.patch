index 0000000..cbc7500
--- /dev/null
+++ b/src/firebase/credentials.js
@@ -0,0 +1,328 @@
+// src/firebase/credentials.js
+//
+// Where the Firebase service account comes from, and whether it is usable.
+//
+// Until now `firebase.js` did `require('./myNaai-firebase.json')`: the key lived
+// in the repository, so it was public, and it was loaded with no checks at all.
+// A key that is public is a key Google revokes — which is exactly what
+// `invalid_grant: Invalid JWT Signature` means. This module makes the
+// credential an environment concern, accepts every shape people actually paste
+// it in, and refuses to hand firebase-admin something that cannot work.
+//
+// It never logs the private key. `describeServiceAccount()` exists so callers
+// can say which key is in use without saying what it is.
+'use strict';
+
+const crypto = require('crypto');
+const fs = require('fs');
+const path = require('path');
+
+// The committed key file, kept only as a last-resort fallback so a deployment
+// that has not been re-configured yet does not lose push entirely. It is
+// public: every log line about it says to delete it in the console.
+const REPO_KEY_FILE = path.join(__dirname, 'myNaai-firebase.json');
+
+const JSON_ENV_VARS = ['FIREBASE_SERVICE_ACCOUNT_JSON', 'FIREBASE_SERVICE_ACCOUNT'];
+const PATH_ENV_VARS = ['FIREBASE_SERVICE_ACCOUNT_PATH', 'GOOGLE_APPLICATION_CREDENTIALS'];
+const LEGACY_ENV_VARS = ['FIREBASE_PROJECT_ID', 'FIREBASE_CLIENT_EMAIL', 'FIREBASE_PRIVATE_KEY'];
+const REQUIRED_FIELDS = ['project_id', 'client_email', 'private_key'];
+const PLACEHOLDERS = /(YOUR[_ -]?PRIVATE[_ -]?KEY|REPLACE[_ -]?ME|\.\.\.\s*$| x{4,})/i;
+
+class CredentialConfigError extends Error {
+    constructor(code, message, hint = '') {
+        super(message);
+        this.name = 'CredentialConfigError';
+        this.code = code;
+        this.hint = hint;
+    }
+}
+
+const ZERO_WIDTH = /[\u200b-\u200d\ufeff]/g;
+
+/**
+ * Turn whatever a `.env` line, a dashboard box or a JSON file produced into a
+ * PEM Node can parse.
+ *
+ * Every one of these is a real way a working key arrives broken:
+ *   · `\n` left as two characters (a `.env` value cannot hold a newline)
+ *   · `\\n` (the JSON string was escaped twice on its way into the variable)
+ *   · the whole value wrapped in quotes
+ *   · a BOM or a zero-width space from a copy-paste
+ *   · the body re-wrapped, indented, or split with spaces
+ */
+function normalizePrivateKey(value) {
+    if (!value) return '';
+    let key = String(value).trim();
+    if (/^(['"])[\s\S]*\1$/.test(key)) key = key.slice(1, -1);
+    // Double-escaped first: `\\n` becomes `\n`, which the next pass turns into a
+    // newline. The other order would eat the second backslash and leave "n".
+    key = key
+        .replace(/\\\\r/g, '\\r')
+        .replace(/\\\\n/g, '\\n')
+        .replace(/\\r/g, '\r')
+        .replace(/\\n/g, '\n');
+    key = key.replace(ZERO_WIDTH, '').replace(/\r\n?/g, '\n').trim();
+
+    const match = /-----BEGIN ([A-Z0-9 ]+)-----([\s\S]*?)-----END \1-----/.exec(key);
+    if (!match) return key; // not a PEM at all: let createPrivateKey explain
+    const body = match[2].replace(/\s+/g, '');
+    const wrapped = body.match(/.{1,64}/g) || [];
+    return `-----BEGIN ${match[1]}-----\n${wrapped.join('\n')}\n-----END ${match[1]}-----`;
+}
+
+/** Parse the many shapes the service-account JSON is pasted in. */
+function parseServiceAccountText(raw, origin = 'credential') {
+    const text = String(raw === null || raw === undefined ? '' : raw).trim();
+    if (!text) {
+        throw new CredentialConfigError(
+            'empty',
+            `${origin} is empty.`,
+            'Set it to the whole service-account JSON, or to a path to that file.'
+        );
+    }
+    if (text.startsWith('-----BEGIN')) {
+        throw new CredentialConfigError(
+            'private-key-only',
+            `${origin} contains only the private key.`,
+            'Paste the entire service-account JSON (project_id, client_email, private_key_id, private_key).'
+        );
+    }
+
+    const candidates = [];
+    if (text.startsWith('{')) candidates.push(text);
+    // `{"type":\"service_account\"...}` — JSON pasted through a shell or a .env
+    if (text.includes('\\"')) candidates.push(text.replace(/\\"/g, '"'));
+    // base64 of the JSON, which is how some hosts want it
+    if (/^[A-Za-z0-9+/=\s]+$/.test(text) && text.length > 64) {
+        candidates.push(Buffer.from(text.replace(/\s+/g, ''), 'base64').toString('utf8'));
+    }
+
+    for (const candidate of candidates) {
+        try {
+            const parsed = JSON.parse(candidate);
+            if (parsed && typeof parsed === 'object' && !Array.isArray(parsed)) {
+                if (parsed.private_key) parsed.private_key = normalizePrivateKey(parsed.private_key);
+                return parsed;
+            }
+        } catch {
+            // try the next shape
+        }
+    }
+
+    throw new CredentialConfigError(
+        'not-json',
+        `${origin} is not the service-account JSON.`,
+        'Download it again from Firebase → Project settings → Service accounts → Generate new private key (or a JSON copy of it, or its base64).'
+    );
+}
+
+function readServiceAccountFile(filePath, origin = 'file') {
+    let text;
+    try {
+        text = fs.readFileSync(filePath, 'utf8');
+    } catch (error) {
+        throw new CredentialConfigError(
+            'file-unreadable',
+            `${origin} could not be read (${error.code || error.message}): ${filePath}`,
+            'Check the path, and that the file is readable by the user that runs the API.'
+        );
+    }
+    return parseServiceAccountText(text, origin);
+}
+
+function serviceAccountFromLegacyEnv(env) {
+    const [projectId, clientEmail, privateKey] = LEGACY_ENV_VARS.map((name) => env[name]);
+    if (!projectId && !clientEmail && !privateKey) return null;
+    return {
+        type: 'service_account',
+        project_id: projectId || '',
+        client_email: clientEmail || '',
+        private_key: normalizePrivateKey(privateKey || ''),
+    };
+}
+
+/** The project a service account belongs to, read from its own address. */
+function projectFromClientEmail(clientEmail) {
+    const match = /@([a-z0-9-]+)\.iam\.gserviceaccount\.com$/i.exec(String(clientEmail || ''));
+    return match ? match[1] : '';
+}
+
+/**
+ * Check a parsed service account without touching the network.
+ *
+ * Returns errors (it cannot work — do not hand it to firebase-admin) and
+ * warnings (it can work, but something about it is worth saying out loud).
+ */
+function validateServiceAccount(serviceAccount, source = 'unknown') {
+    const errors = [];
+    const warnings = [];
+    const sa = serviceAccount || {};
+
+    for (const field of REQUIRED_FIELDS) {
+        if (!sa[field] || typeof sa[field] !== 'string' || !sa[field].trim()) {
+            errors.push({
+                code: 'missing-field',
+                message: `the service account has no "${field}".`,
+                hint: 'Use the whole JSON from Firebase → Project settings → Service accounts.',
+            });
+        }
+    }
+
+    let keyType = '';
+    let bits = 0;
+    if (sa.private_key && String(sa.private_key).trim()) {
+        if (PLACEHOLDERS.test(String(sa.private_key)) && !/-----BEGIN/.test(String(sa.private_key))) {
+            errors.push({
+                code: 'placeholder-key',
+                message: 'the private key is a placeholder, not a key.',
+                hint: 'Download a real key file; placeholders sign nothing.',
+            });
+        } else {
+            try {
+                const key = crypto.createPrivateKey(sa.private_key);
+                keyType = key.asymmetricKeyType || '';
+                bits = (key.asymmetricKeyDetails && key.asymmetricKeyDetails.modulusLength) || 0;
+                if (keyType !== 'rsa') {
+                    errors.push({
+                        code: 'not-rsa',
+                        message: `the private key is ${keyType || 'not RSA'}; Google signs these tokens with RS256.`,
+                        hint: 'Download a fresh key from the same page — it must be a service-account JSON key.',
+                    });
+                } else if (bits && bits < 2048) {
+                    warnings.push(`the private key is only ${bits} bits.`);
+                }
+            } catch (error) {
+                errors.push({
+                    code: 'unparsable-key',
+                    message: `the private key cannot be parsed (${error.message}).`,
+                    hint: 'It is usually a key that lost its newlines or was truncated — paste the whole JSON, one value, and let the API repair the newlines.',
+                });
+            }
+        }
+    }
+
+    if (sa.type && sa.type !== 'service_account') {
+        warnings.push(`"type" is "${sa.type}", not "service_account".`);
+    }
+    if (sa.client_email && sa.project_id) {
+        const ownProject = projectFromClientEmail(sa.client_email);
+        if (ownProject && ownProject !== sa.project_id) {
+            warnings.push(
+                `client_email belongs to project "${ownProject}" but project_id says "${sa.project_id}" — ` +
+                'a key from another project was pasted in.'
+            );
+        }
+    }
+    if (!sa.private_key_id) {
+        warnings.push('there is no private_key_id, so a revoked key cannot be told apart from a wrong one.');
+    }
+    if (source === REPO_KEY_FILE || /myNaai-firebase\.json$/.test(String(source))) {
+        warnings.push(
+            'this key file is committed to the repository, so it is public. Keys found in public repositories ' +
+            'are revoked by Google. Generate a new key, move it to the environment, and delete this one.'
+        );
+    }
+
+    return {
+        ok: errors.length === 0,
+        errors,
+        warnings,
+        facts: {
+            projectId: sa.project_id || '',
+            clientEmail: sa.client_email || '',
+            privateKeyId: sa.private_key_id || '',
+            tokenUri: sa.token_uri || 'https://oauth2.googleapis.com/token',
+            keyType,
+            keyBits: bits,
+            source,
+        },
+    };
+}
+
+/** What is in use, said without saying the secret. */
+function describeServiceAccount(serviceAccount, source = 'unknown') {
+    const sa = serviceAccount || {};
+    const key = String(sa.private_key || '');
+    const lines = (key.match(/\n/g) || []).length + (key ? 1 : 0);
+    const result = validateServiceAccount(sa, source);
+    return {
+        ...result.facts,
+        keyLines: key ? lines : 0,
+        keyLength: key.length,
+        ok: result.ok,
+        errors: result.errors,
+        warnings: result.warnings,
+        // Deliberately not the key: a fingerprint is enough to tell two keys apart.
+        keyFingerprint: key
+            ? crypto.createHash('sha256').update(key.replace(/\s+/g, '')).digest('hex').slice(0, 16)
+            : '',
+    };
+}
+
+/**
+ * Resolve the service account from the environment, in priority order:
+ *
+ *   1. FIREBASE_SERVICE_ACCOUNT_JSON  (JSON, escaped JSON, or base64 of it)
+ *   2. FIREBASE_SERVICE_ACCOUNT_PATH  (a file)
+ *   3. GOOGLE_APPLICATION_CREDENTIALS (the Google-wide convention)
+ *   4. FIREBASE_PROJECT_ID / FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY
+ *   5. the committed src/firebase/myNaai-firebase.json — deprecated, public
+ *
+ * A configured source that is broken is REPORTED, not skipped: silently falling
+ * through from a typo'd variable to a key that was revoked months ago is how
+ * somebody spends an evening debugging a 401.
+ */
+function loadServiceAccount({ env = process.env, includeRepoFile = true } = {}) {
+    for (const name of JSON_ENV_VARS) {
+        if (!env[name]) continue;
+        const serviceAccount = parseServiceAccountText(env[name], `$${name}`);
+        return finish(serviceAccount, `env ${name}`);
+    }
+    for (const name of PATH_ENV_VARS) {
+        if (!env[name]) continue;
+        const serviceAccount = readServiceAccountFile(env[name], `$${name}`);
+        return finish(serviceAccount, env[name]);
+    }
+    const legacy = serviceAccountFromLegacyEnv(env);
+    if (legacy) {
+        return finish(
+            legacy,
+            'env FIREBASE_PRIVATE_KEY',
+            'Set all three (FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, FIREBASE_PRIVATE_KEY), or set FIREBASE_SERVICE_ACCOUNT_JSON to the whole JSON.'
+        );
+    }
+    if (includeRepoFile && fs.existsSync(REPO_KEY_FILE)) {
+        return finish(readServiceAccountFile(REPO_KEY_FILE, REPO_KEY_FILE), REPO_KEY_FILE);
+    }
+
+    throw new CredentialConfigError(
+        'missing',
+        'no Firebase service account is configured.',
+        'Set FIREBASE_SERVICE_ACCOUNT_JSON (or FIREBASE_SERVICE_ACCOUNT_PATH) to a service-account key from Firebase → Project settings → Service accounts.'
+    );
+
+    function finish(serviceAccount, source, hint) {
+        const validation = validateServiceAccount(serviceAccount, source);
+        if (!validation.ok) {
+            const reason = validation.errors.map((item) => item.message).join(' ');
+            throw new CredentialConfigError(
+                validation.errors[0].code,
+                `${source}: ${reason}`,
+                hint || validation.errors[0].hint
+            );
+        }
+        return { serviceAccount, source, warnings: validation.warnings, facts: validation.facts };
+    }
+}
+
+module.exports = {
+    CredentialConfigError,
+    REPO_KEY_FILE,
+    normalizePrivateKey,
+    parseServiceAccountText,
+    readServiceAccountFile,
+    projectFromClientEmail,
+    validateServiceAccount,
+    describeServiceAccount,
+    loadServiceAccount,
+};
