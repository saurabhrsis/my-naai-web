diff --git a/scripts/test-event-notifications.js b/scripts/test-event-notifications.js
new file mode 100644
index 0000000..5270d13
--- /dev/null
+++ b/scripts/test-event-notifications.js
@@ -0,0 +1,155 @@
+// Event notifications — self-check that runs without a database or Firebase.
+//
+//   npm run event:test-notifications
+//
+// `services/eventNotification.service.js` is the one path that writes the
+// admin panel's event rows and the salon's own notifications. It must:
+//
+//   • write an admin row with the internal target type ADMINS;
+//   • write the salon's row and push to every active device once;
+//   • NEVER throw — an order is placed and a salon is created whatever Firebase
+//     or Postgres answered.
+//
+// This stubs the two dependencies (the Sequelize models and the FCM sender) in
+// Node's require cache and exercises the real service file.
+const path = require('path');
+const assert = require('assert');
+
+const ROOT = path.join(__dirname, '..');
+const modelsPath = require.resolve(path.join(ROOT, 'src/database/models'));
+const firebasePath = require.resolve(path.join(ROOT, 'src/firebase/sendNotification'));
+
+const calls = { admin: [], notification: [], push: [], tokens: [] };
+const fakeDb = {
+    AdminNotification: {
+        create: async (row) => {
+            if (fakeDb.failAdmin) throw new Error('invalid input value for enum: "ADMINS"');
+            calls.admin.push(row);
+            return { id: 'admin-row', ...row };
+        },
+    },
+    Notification: {
+        create: async (row) => {
+            if (fakeDb.failSalon) throw new Error('notifications insert failed');
+            calls.notification.push(row);
+            return { notificationId: 'notification-row', ...row };
+        },
+    },
+    DeviceToken: {
+        findAll: async ({ where }) => {
+            calls.tokens.push(where);
+            if (fakeDb.failTokens) throw new Error('device_tokens lookup failed');
+            return where.salonId === 'salon-1'
+                ? [{ deviceToken: 'token-1' }, { deviceToken: 'token-2' }, { deviceToken: 'token-1' }]
+                : [];
+        },
+    },
+};
+fakeDb.failAdmin = false;
+fakeDb.failSalon = false;
+fakeDb.failTokens = false;
+
+require.cache[modelsPath] = { id: modelsPath, filename: modelsPath, loaded: true, exports: fakeDb };
+require.cache[firebasePath] = {
+    id: firebasePath,
+    filename: firebasePath,
+    loaded: true,
+    exports: async (token, title, body, data) => {
+        calls.push.push({ token, title, body, data });
+        // One device failing must not stop the others, and must not throw.
+        if (token === 'token-2') throw new Error('messaging/registration-token-not-registered');
+        return true;
+    },
+};
+
+const service = require(path.join(ROOT, 'src/services/eventNotification.service.js'));
+
+const check = async (label, fn) => {
+    await fn();
+    console.log(`  ✓ ${label}`);
+};
+
+(async () => {
+    console.log('\nEvent notification checks\n');
+
+    await check('an admin event row uses the internal ADMINS target type', async () => {
+        calls.admin.length = 0;
+        await service.notifyAdmins({ title: 'New shop order', body: 'Rita placed order NAI-1234' });
+        assert.strictEqual(calls.admin.length, 1);
+        assert.strictEqual(calls.admin[0].targetType, 'ADMINS');
+        assert.strictEqual(calls.admin[0].createdBy, null);
+        assert.strictEqual(calls.admin[0].isRead, false);
+    });
+
+    await check('a failing admin row is logged, not thrown', async () => {
+        fakeDb.failAdmin = true;
+        const result = await service.notifyAdmins({ title: 'x', body: 'y' });
+        assert.strictEqual(result, null);
+        fakeDb.failAdmin = false;
+    });
+
+    await check('the salon gets its own row and one push per device', async () => {
+        calls.notification.length = 0;
+        calls.push.length = 0;
+        await service.notifySalon({ salonId: 'salon-1', title: 'Order placed', body: 'Order NAI-1234', data: { type: 'SHOP_ORDER' } });
+        assert.strictEqual(calls.notification.length, 1);
+        assert.strictEqual(calls.notification[0].receiverType, 'SALON');
+        assert.strictEqual(calls.notification[0].receiverId, 'salon-1');
+        assert.deepStrictEqual(calls.push.map(entry => entry.token).sort(), ['token-1', 'token-2'], 'duplicate tokens are sent once');
+        assert.strictEqual(calls.push[0].data.type, 'SHOP_ORDER');
+    });
+
+    await check('an event with no salon writes no salon notification', async () => {
+        calls.notification.length = 0;
+        const result = await service.notifySalon({ salonId: null, title: 'x', body: 'y' });
+        assert.strictEqual(result, null);
+        assert.strictEqual(calls.notification.length, 0);
+    });
+
+    await check('a failed device lookup still leaves the salon row', async () => {
+        calls.notification.length = 0;
+        calls.push.length = 0;
+        fakeDb.failTokens = true;
+        const row = await service.notifySalon({ salonId: 'salon-1', title: 't', body: 'b' });
+        assert.ok(row, 'the inbox row is written even when the device lookup fails');
+        fakeDb.failTokens = false;
+    });
+
+    await check('a failed salon row still sends the push', async () => {
+        calls.push.length = 0;
+        fakeDb.failSalon = true;
+        const result = await service.notifySalon({ salonId: 'salon-1', title: 't', body: 'b' });
+        assert.strictEqual(result, null);
+        assert.strictEqual(calls.push.length, 2);
+        fakeDb.failSalon = false;
+    });
+
+    await check('one call reaches both audiences', async () => {
+        calls.admin.length = 0;
+        calls.notification.length = 0;
+        await service.notifyAdminsAndSalon({
+            salonId: 'salon-1',
+            adminTitle: 'Delivery partner assigned',
+            adminBody: 'Ravi was assigned to order NAI-1234',
+            title: 'Delivery partner assigned',
+            body: 'Ravi will deliver order NAI-1234.',
+        });
+        assert.strictEqual(calls.admin.length, 1);
+        assert.strictEqual(calls.notification.length, 1);
+        assert.strictEqual(calls.admin[0].title, 'Delivery partner assigned');
+        assert.strictEqual(calls.notification[0].title, 'Delivery partner assigned');
+    });
+
+    await check('copy is trimmed to the column sizes', async () => {
+        calls.admin.length = 0;
+        await service.notifyAdmins({ title: 'x'.repeat(300), body: 'y'.repeat(600) });
+        const row = calls.admin[0];
+        assert.ok(row.title.length <= 120, 'title fits the 120-character title column');
+        assert.ok(row.body.length <= 240, 'body fits the 240-character body copy');
+    });
+
+    console.log('\nAll event-notification checks passed.\n');
+})().catch((error) => {
+    console.error('\n✗ Event notification check failed:', error.message, '\n');
+    process.exit(1);
+});
