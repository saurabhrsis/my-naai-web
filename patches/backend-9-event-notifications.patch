diff --git a/src/services/eventNotification.service.js b/src/services/eventNotification.service.js
new file mode 100644
index 0000000..094945e
--- /dev/null
+++ b/src/services/eventNotification.service.js
@@ -0,0 +1,118 @@
+const db = require('../database/models');
+const sendNotificationToDevice = require('../firebase/sendNotification');
+
+// One place for the five events the owner wants visible on BOTH sides:
+//
+//   • a new shop order                (shopOrder.service.createOrder)
+//   • a new salon registration        (razorpay/createSalonWithPlan)
+//   • a subscription renewal          (razorpay/renewSalonPlan)
+//   • a delivery-partner action       (shopOrder.service: assign/accept/reject/status)
+//   • a new booking request           (bookingRequest/bookingRequest)
+//
+// The two audiences are different, so there are two functions:
+//
+//   notifyAdmins({ title, body })            → one row in the admin panel's inbox
+//   notifySalon({ salonId, title, body, data }) → the salon's inbox + a push
+//
+// NEITHER function may break the business action it describes. An order is
+// placed whether or not Firebase answered, a salon is created whether or not the
+// admin inbox row was written — every failure is logged and swallowed here, and
+// every caller may simply `await` without a try/catch.
+
+// `ADMINS` is an INTERNAL target: the row exists for the admin panel only. The
+// salon list filters `targetType IN ('ALL','ALL_SALONS')` and the customer list
+// filters `('ALL','ALL_USERS')`, so an internal event can never appear in a
+// partner's or a customer's notifications. (Migration: patches/migrations/
+// 2026-11-06-admin-event-notifications.sql adds the enum value.)
+const ADMIN_TARGET = 'ADMINS';
+
+const shortText = (value, max = 180) => {
+    const text = String(value ?? '').replace(/\s+/g, ' ').trim();
+    return text.length > max ? `${text.slice(0, max - 1)}…` : text;
+};
+
+/**
+ * Write one inbox entry for the admin panel. No device push: an admin is a
+ * panel session, not an FCM registration, so there is no token to send to —
+ * the notification appears in the panel's list (and its unread count).
+ */
+const notifyAdmins = async ({ title, body }) => {
+    try {
+        const notification = await db.AdminNotification.create({
+            targetType: ADMIN_TARGET,
+            title: shortText(title, 120) || 'My Naai event',
+            body: shortText(body, 240),
+            createdBy: null,
+            isRead: false,
+        });
+        return notification;
+    } catch (error) {
+        console.error('❌ Admin event Notification Error:', error.message);
+        return null;
+    }
+};
+
+/**
+ * The salon's own record of the same event: a `notifications` row it reads in
+ * the app, plus the FCM push to every active device of that salon.
+ *
+ * The row is written even with no device tokens, so the event is never lost
+ * from the inbox — the push is the extra.
+ */
+const notifySalon = async ({ salonId, title, body, data = {} }) => {
+    if (!salonId) return null;
+    const safeTitle = shortText(title, 120) || 'My Naai update';
+    const safeBody = shortText(body, 240);
+
+    let notification = null;
+    try {
+        notification = await db.Notification.create({
+            receiverType: 'SALON',
+            receiverId: salonId,
+            title: safeTitle,
+            message: safeBody,
+        });
+    } catch (error) {
+        console.error('❌ Salon Notification row Error:', error.message);
+    }
+
+    try {
+        const devices = await db.DeviceToken.findAll({
+            where: { salonId, isActive: true },
+            attributes: ['deviceToken'],
+        });
+        const tokens = [...new Set(devices.map((device) => device.deviceToken).filter(Boolean))];
+        if (tokens.length) {
+            await Promise.allSettled(tokens.map((token) => sendNotificationToDevice(token, safeTitle, safeBody, {
+                ...data,
+                type: data.type || 'SALON_EVENT',
+                title: safeTitle,
+                body: safeBody,
+            })));
+        }
+    } catch (error) {
+        console.error('❌ Salon Notification push Error:', error.message);
+    }
+
+    return notification;
+};
+
+/**
+ * Both sides of one event, in one call — the shape most callers want.
+ * `salonId` is optional: an event with no salon (a customer's shop order) still
+ * reaches the admin panel.
+ */
+const notifyAdminsAndSalon = async ({ salonId, adminTitle, adminBody, title, body, data = {} }) => {
+    const [admin] = await Promise.all([
+        notifyAdmins({ title: adminTitle || title, body: adminBody || body }),
+        salonId ? notifySalon({ salonId, title, body, data }) : Promise.resolve(null),
+    ]);
+    return admin;
+};
+
+module.exports = {
+    ADMIN_TARGET,
+    notifyAdmins,
+    notifySalon,
+    notifyAdminsAndSalon,
+};
