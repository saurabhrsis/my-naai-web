diff --git a/src/components/LocationField.jsx b/src/components/LocationField.jsx
new file mode 100644
index 0000000..db07f30
--- /dev/null
+++ b/src/components/LocationField.jsx
@@ -0,0 +1,250 @@
+import { useEffect, useState } from "react";
+import { Button, Form, Spinner } from "react-bootstrap";
+import { Crosshair, ExternalLink, MapPin, Search, Trash2 } from "lucide-react";
+import { toast } from "react-toastify";
+import LocationMap from "./LocationMap.jsx";
+import {
+  formatCoordinates,
+  isValidLatitude,
+  isValidLongitude,
+  mapsUrl,
+  requestBrowserLocation,
+  toCoordinate,
+  toPoint
+} from "../utils/geo";
+
+/**
+ * LocationField — the "where is this?" control used by Add/Edit Distributor
+ * and by the delivery-pin correction on an order.
+ *
+ * Four ways in, because a dispatcher is not always standing at the point:
+ *   1. a map click (or dragging the pin);
+ *   2. "Use my current location" (browser GPS — the phone in their hand);
+ *   3. a place search (OpenStreetMap Nominatim, no key);
+ *   4. typing the coordinates (read off another device or a paper sheet).
+ *
+ * `onChange({ latitude, longitude } | null)` — null clears the pin.
+ */
+const LocationField = ({
+  value = null,
+  onChange,
+  label = "Location",
+  helper = "Pin the pickup / base point. This is what makes the KM and the nearest-first list work.",
+  height = 240,
+  disabled = false,
+  required = false
+}) => {
+  const point = toPoint(value);
+  const [latText, setLatText] = useState(point ? String(point.latitude) : "");
+  const [lngText, setLngText] = useState(point ? String(point.longitude) : "");
+  const [locating, setLocating] = useState(false);
+  const [search, setSearch] = useState("");
+  const [searching, setSearching] = useState(false);
+  const [results, setResults] = useState([]);
+
+  // Keep the text inputs in step with the pin (map click, GPS, or a parent
+  // that loaded a saved distributor), without fighting the user while typing.
+  useEffect(() => {
+    if (!point) {
+      setLatText("");
+      setLngText("");
+      return;
+    }
+    setLatText(String(point.latitude));
+    setLngText(String(point.longitude));
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, [point?.latitude, point?.longitude]);
+
+  const commit = (next) => {
+    if (disabled) return;
+    const clean = toPoint(next);
+    onChange?.(clean ? { latitude: clean.latitude, longitude: clean.longitude } : null);
+  };
+
+  const useCurrentLocation = async () => {
+    if (disabled) return;
+    setLocating(true);
+    try {
+      const result = await requestBrowserLocation();
+      if (!result.ok) {
+        toast.error(result.message || "Could not read this device's location");
+        return;
+      }
+      commit({ latitude: result.latitude, longitude: result.longitude });
+      toast.success("Current location captured");
+    } finally {
+      setLocating(false);
+    }
+  };
+
+  const applyTypedCoordinates = () => {
+    const latitude = toCoordinate(latText);
+    const longitude = toCoordinate(lngText);
+    if (latitude === null && longitude === null) {
+      commit(null);
+      return;
+    }
+    if (!isValidLatitude(latitude) || !isValidLongitude(longitude)) {
+      toast.error("Enter a valid pair — latitude −90…90 and longitude −180…180");
+      return;
+    }
+    commit({ latitude, longitude });
+  };
+
+  const runSearch = async (event) => {
+    event.preventDefault();
+    const query = search.trim();
+    if (query.length < 3) {
+      toast.error("Type at least 3 characters to search a place");
+      return;
+    }
+    setSearching(true);
+    try {
+      // Free & key-less. `countrycodes=in` because every partner so far is in
+      // India; drop it if the platform ever delivers elsewhere.
+      const response = await fetch(
+        `https://nominatim.openstreetmap.org/search?format=jsonv2&limit=5&countrycodes=in&q=${encodeURIComponent(query)}`,
+        { headers: { Accept: "application/json" } }
+      );
+      if (!response.ok) throw new Error("search failed");
+      const rows = await response.json();
+      setResults(Array.isArray(rows) ? rows : []);
+      if (!rows.length) toast.info("No place matched — drop the pin on the map instead.");
+    } catch {
+      toast.error("Place search is unavailable right now — drop the pin on the map instead.");
+    } finally {
+      setSearching(false);
+    }
+  };
+
+  const chooseResult = (row) => {
+    commit({ latitude: Number(row.lat), longitude: Number(row.lon) });
+    setResults([]);
+    setSearch("");
+  };
+
+  const openMap = () => {
+    const url = mapsUrl(point);
+    if (url) window.open(url, "_blank", "noopener,noreferrer");
+  };
+
+  return (
+    <div className="border rounded-3 p-3" style={{ background: "#fff" }}>
+      <div className="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
+        <div>
+          <div className="fw-semibold small text-dark d-flex align-items-center gap-1">
+            <MapPin size={14} /> {label} {required && <span className="text-danger">*</span>}
+          </div>
+          <div className="text-muted" style={{ fontSize: "0.78rem" }}>{helper}</div>
+        </div>
+        <div className="d-flex gap-2">
+          <Button
+            type="button"
+            variant="outline-secondary"
+            size="sm"
+            className="d-flex align-items-center gap-1"
+            onClick={useCurrentLocation}
+            disabled={disabled || locating}
+          >
+            {locating ? <Spinner animation="border" size="sm" /> : <Crosshair size={14} />}
+            {locating ? "Locating…" : "Use my location"}
+          </Button>
+          {point && (
+            <>
+              <Button type="button" variant="outline-primary" size="sm" className="d-flex align-items-center gap-1" onClick={openMap} disabled={disabled}>
+                <ExternalLink size={14} /> Map
+              </Button>
+              <Button type="button" variant="outline-danger" size="sm" className="d-flex align-items-center gap-1" onClick={() => commit(null)} disabled={disabled}>
+                <Trash2 size={14} /> Clear
+              </Button>
+            </>
+          )}
+        </div>
+      </div>
+
+      <LocationMap
+        value={point}
+        onChange={commit}
+        readOnly={disabled}
+        height={height}
+        ariaLabel={`${label} map`}
+      />
+
+      <Form
+        className="d-flex flex-wrap gap-2 align-items-end mt-2"
+        onSubmit={(event) => {
+          event.preventDefault();
+          applyTypedCoordinates();
+        }}
+      >
+        <div style={{ flex: "1 1 130px", minWidth: 0 }}>
+          <Form.Label className="small text-muted mb-1" style={{ fontSize: "0.75rem" }}>Latitude</Form.Label>
+          <Form.Control
+            size="sm"
+            value={latText}
+            inputMode="decimal"
+            placeholder="21.14580"
+            onChange={(event) => setLatText(event.target.value)}
+            onBlur={applyTypedCoordinates}
+            disabled={disabled}
+          />
+        </div>
+        <div style={{ flex: "1 1 130px", minWidth: 0 }}>
+          <Form.Label className="small text-muted mb-1" style={{ fontSize: "0.75rem" }}>Longitude</Form.Label>
+          <Form.Control
+            size="sm"
+            value={lngText}
+            inputMode="decimal"
+            placeholder="79.08820"
+            onChange={(event) => setLngText(event.target.value)}
+            onBlur={applyTypedCoordinates}
+            disabled={disabled}
+          />
+        </div>
+        <div style={{ flex: "1 1 200px", minWidth: 0 }}>
+          <Form.Label className="small text-muted mb-1" style={{ fontSize: "0.75rem" }}>Search a place</Form.Label>
+          <div className="d-flex gap-1">
+            <Form.Control
+              size="sm"
+              value={search}
+              placeholder="e.g. Sitabuldi, Nagpur"
+              onChange={(event) => setSearch(event.target.value)}
+              disabled={disabled}
+            />
+            <Button type="submit" size="sm" variant="outline-secondary" onClick={runSearch} disabled={disabled || searching}>
+              {searching ? <Spinner animation="border" size="sm" /> : <Search size={14} />}
+            </Button>
+          </div>
+        </div>
+      </Form>
+
+      {results.length > 0 && (
+        <div className="list-group mt-2" style={{ maxHeight: "150px", overflowY: "auto" }}>
+          {results.map((row) => (
+            <button
+              key={`${row.place_id}`}
+              type="button"
+              className="list-group-item list-group-item-action py-2 small"
+              onClick={() => chooseResult(row)}
+            >
+              <strong className="d-block text-dark">{row.name || row.display_name}</strong>
+              <span className="text-muted" style={{ fontSize: "0.76rem" }}>{row.display_name}</span>
+            </button>
+          ))}
+        </div>
+      )}
+
+      <div className="mt-2 small text-muted">
+        {point ? (
+          <span>
+            <strong className="text-dark">Saved point:</strong> {formatCoordinates(point)}
+          </span>
+        ) : (
+          <span>No point set — the partner will not appear as “nearest” until one is saved.</span>
+        )}
+      </div>
+    </div>
+  );
+};
+
+export default LocationField;
diff --git a/src/components/LocationMap.jsx b/src/components/LocationMap.jsx
new file mode 100644
index 0000000..8641ac9
--- /dev/null
+++ b/src/components/LocationMap.jsx
@@ -0,0 +1,235 @@
+import { useEffect, useMemo, useRef } from "react";
+import L from "leaflet";
+import "leaflet/dist/leaflet.css";
+import { toPoint } from "../utils/geo";
+
+/**
+ * LocationMap — the one map component in the panel.
+ *
+ * Free stack on purpose: OpenStreetMap raster tiles rendered by Leaflet. No
+ * API key, no billing account, no Google Maps SDK to keep in sync with a
+ * project. The component is deliberately small:
+ *
+ *   · read-only mode  — the delivery location on an order, the pin a salon
+ *                       saved, the partner's live position;
+ *   · editable mode   — drop/move a pin (map click, drag, GPS, typed
+ *                       coordinates) while adding or editing a distributor.
+ *
+ * Markers are drawn as div-icons rather than Leaflet's default PNG icon: the
+ * default icon resolves its image path at runtime, which breaks under Vite's
+ * bundling and leaves a broken-image square on the map.
+ */
+
+const TILE_URL = "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png";
+const TILE_ATTRIBUTION =
+  '&copy; <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noreferrer">OpenStreetMap</a> contributors';
+// India, zoomed out — the neutral view when nothing has a coordinate yet.
+const FALLBACK_CENTER = [21.1458, 79.0882];
+const FALLBACK_ZOOM = 5;
+
+const pinIcon = (color) =>
+  L.divIcon({
+    className: "mynaai-map-pin-wrap",
+    html: `<span class="mynaai-map-pin" style="--pin-color:${color}"><span class="mynaai-map-pin-dot"></span></span>`,
+    iconSize: [24, 24],
+    iconAnchor: [12, 12]
+  });
+
+const LocationMap = ({
+  value = null,
+  markers = [],
+  onChange = null,
+  readOnly = false,
+  height = 220,
+  zoom = null,
+  fit = false,
+  ariaLabel = "Map",
+  style = {}
+}) => {
+  const containerRef = useRef(null);
+  const mapRef = useRef(null);
+  const layerRef = useRef(null);
+  const onChangeRef = useRef(onChange);
+  const primaryMarkerRef = useRef(null);
+
+  useEffect(() => {
+    onChangeRef.current = onChange;
+  }, [onChange]);
+
+  const point = toPoint(value);
+
+  // Extra pins (the salon's location, the partner's live fix, …). A stable
+  // signature keeps the marker-sync effect from re-running on every render of
+  // a parent that rebuilds its array.
+  const markerSignature = useMemo(
+    () =>
+      (markers || [])
+        .map((marker) => {
+          const p = toPoint(marker);
+          return p ? `${p.latitude.toFixed(5)},${p.longitude.toFixed(5)},${marker.color || ""},${marker.label || ""}` : "";
+        })
+        .filter(Boolean)
+        .join("|"),
+    [markers]
+  );
+
+  /* ---------------- map lifecycle ---------------- */
+  useEffect(() => {
+    if (!containerRef.current || mapRef.current) return undefined;
+    const start = toPoint(value) || { latitude: FALLBACK_CENTER[0], longitude: FALLBACK_CENTER[1] };
+    const map = L.map(containerRef.current, {
+      center: [start.latitude, start.longitude],
+      zoom: zoom || (toPoint(value) ? 13 : FALLBACK_ZOOM),
+      scrollWheelZoom: false,
+      attributionControl: true
+    });
+    L.tileLayer(TILE_URL, { attribution: TILE_ATTRIBUTION, maxZoom: 19 }).addTo(map);
+    mapRef.current = map;
+    layerRef.current = L.layerGroup().addTo(map);
+
+    // A modal that animates in has a 0×0 container at mount; sizing once after
+    // the transition (and on any later resize) is what stops the grey tiles.
+    const settle = () => {
+      try {
+        map.invalidateSize();
+      } catch {
+        /* the map was already torn down */
+      }
+    };
+    const timer = setTimeout(settle, 120);
+    let observer = null;
+    if (typeof ResizeObserver !== "undefined" && containerRef.current) {
+      observer = new ResizeObserver(settle);
+      observer.observe(containerRef.current);
+    }
+    window.addEventListener("resize", settle);
+
+    return () => {
+      clearTimeout(timer);
+      window.removeEventListener("resize", settle);
+      if (observer) observer.disconnect();
+      map.remove();
+      mapRef.current = null;
+      layerRef.current = null;
+      primaryMarkerRef.current = null;
+    };
+    // Mount-only: `value`/`zoom` changes are handled by the sync effect below.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  /* ---------------- click / drag to set the pin ---------------- */
+  useEffect(() => {
+    const map = mapRef.current;
+    if (!map || readOnly || !onChange) return undefined;
+    map.getContainer().classList.add("mynaai-map-editable");
+    const handleClick = (event) => {
+      onChangeRef.current?.({
+        latitude: Number(event.latlng.lat.toFixed(6)),
+        longitude: Number(event.latlng.lng.toFixed(6))
+      });
+    };
+    map.on("click", handleClick);
+    return () => {
+      map.off("click", handleClick);
+      map.getContainer()?.classList.remove("mynaai-map-editable");
+    };
+  }, [readOnly, onChange]);
+
+  /* ---------------- markers ---------------- */
+  useEffect(() => {
+    const map = mapRef.current;
+    const layer = layerRef.current;
+    if (!map || !layer) return;
+    layer.clearLayers();
+    primaryMarkerRef.current = null;
+
+    if (point) {
+      const marker = L.marker([point.latitude, point.longitude], {
+        icon: pinIcon(readOnly ? "#0d6efd" : "#198754"),
+        draggable: !readOnly && Boolean(onChange),
+        keyboard: false,
+        title: readOnly ? "Location" : "Drag to adjust the location"
+      }).addTo(layer);
+      if (!readOnly && onChange) {
+        marker.on("dragend", () => {
+          const next = marker.getLatLng();
+          onChangeRef.current?.({
+            latitude: Number(next.lat.toFixed(6)),
+            longitude: Number(next.lng.toFixed(6))
+          });
+        });
+      }
+      primaryMarkerRef.current = marker;
+    }
+
+    const extraPoints = [];
+    (markers || []).forEach((raw) => {
+      const p = toPoint(raw);
+      if (!p) return;
+      extraPoints.push([p.latitude, p.longitude]);
+      L.marker([p.latitude, p.longitude], {
+        icon: pinIcon(raw.color || "#dc3545"),
+        keyboard: false,
+        title: raw.label || "Location"
+      })
+        .addTo(layer)
+        .bindPopup(raw.label ? `<strong>${raw.label}</strong>` : "");
+    });
+
+    if (point) extraPoints.push([point.latitude, point.longitude]);
+    if (!extraPoints.length) return;
+
+    if (fit && extraPoints.length > 1) {
+      map.fitBounds(L.latLngBounds(extraPoints).pad(0.35), { maxZoom: 14, animate: false });
+      return;
+    }
+    map.setView(extraPoints[extraPoints.length - 1], zoom || Math.max(map.getZoom(), 13), { animate: false });
+  }, [point?.latitude, point?.longitude, markerSignature, readOnly, onChange, fit, zoom]);
+
+  const empty = !point && !(markers || []).some((marker) => toPoint(marker));
+
+  return (
+    <div className="position-relative" style={{ borderRadius: "10px", overflow: "hidden", ...style }}>
+      <div
+        ref={containerRef}
+        role="img"
+        aria-label={ariaLabel}
+        style={{ height: `${height}px`, width: "100%", background: "#eef2f6" }}
+      />
+      {empty && (
+        <div
+          className="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center text-center px-3"
+          style={{ background: "rgba(248,249,250,0.92)", pointerEvents: "none" }}
+        >
+          <div className="small text-muted">
+            <strong className="d-block text-dark mb-1">No location saved yet</strong>
