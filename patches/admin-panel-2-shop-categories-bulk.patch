+                            <ArrowUp size={13} />
+                          </button>
+                          <button
+                            className="btn btn-sm btn-light border"
+                            title="Move down"
+                            disabled={saving || index === categories.length - 1}
+                            onClick={() => handleMove(index, 1)}
+                          >
+                            <ArrowDown size={13} />
+                          </button>
+                        </div>
+                      </td>
+                      <td>
+                        {editing?.id === category.id ? (
+                          <div className="d-flex gap-2">
