+            size="sm"
+            disabled={saving || (deleteTarget?.productCount > 0 && !moveTo)}
+            onClick={() => handleDelete(moveTo)}
+          >
+            {deleteTarget?.productCount > 0 && moveTo ? "Move products and delete" : "Delete category"}
+          </Button>
+        </Modal.Footer>
+      </Modal>
+    </Modal>
+  );
+};
+
+export default ShopCategoriesModal;
