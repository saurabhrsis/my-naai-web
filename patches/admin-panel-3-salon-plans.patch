@@ -0,0 +1,970 @@
+import { useState, useEffect, useMemo } from "react";
+import { partnerPlanAPI } from "../services/communication";
+import Layout from "../components/Layout.jsx";
+import Loader from "../components/Loader.jsx";
+import { toast } from "react-toastify";
+import { useNavigate } from "react-router-dom";
+import {
+  CalendarClock,
+  IndianRupee,
+  Save,
+  Plus,
+  Trash2,
+  Power,
+  Star,
+  RefreshCw,
+  Info,
+  Users,
+  Sparkles,
+} from "lucide-react";
+
+// Plans & Trials — the single source of truth for what a salon pays and for how
+// long a brand-new salon gets free. Until this screen existed those numbers were
+// compiled into three repositories (`plan.util.js` in the backend, `PARTNER_PLANS`
+// in the website, a constant in the app), so a price change was a release of all
+// three — and the free trial was a literal `+ 20` in `salonLogin.js` while the
+// portal advertised 20 days and the pricing screen said 60.
+//
+// Editing a row here changes the website and the app on the next read: both call
+// the public twin of this list (`POST /api/salons/plans/list`), which reads the
+// same table. A plan id is created here and never re-slugged, because
+// `salons.planType` and every paid subscription store it.
+const DURATION = (days) => {
+  const n = Number(days);
+  if (!Number.isFinite(n) || n <= 0) return "—";
+  if (n % 365 === 0) return n === 365 ? "1 Year (365 Days)" : `${n / 365} Years (${n} Days)`;
+  if (n % 30 === 0) return n === 30 ? "1 Month (30 Days)" : `${n / 30} Months (${n} Days)`;
+  return `${n} Day${n === 1 ? "" : "s"}`;
+};
+
+const ROW_STYLE = {
+  background: "#ffffff",
+  borderRadius: "16px",
+  boxShadow: "0 0.125rem 0.25rem rgba(0, 0, 0, 0.075)",
+};
+
+const INPUT = {
+  width: "100%",
+  boxSizing: "border-box",
+  padding: "9px 12px",
+  fontSize: "0.95rem",
+  color: "#212529",
+  background: "#ffffff",
+  border: "1px solid #ced4da",
+  borderRadius: "8px",
+  outline: "none",
+};
+
+const FIELD_LABEL = {
+  display: "block",
+  marginBottom: "6px",
+  fontSize: "0.75rem",
+  fontWeight: "700",
+  letterSpacing: "0.03em",
+  textTransform: "uppercase",
+  color: "#6c757d",
+};
+
+const draftFrom = (plan) => ({
+  id: plan.id,
+  label: plan.label || plan.title || "",
+  price: plan.price ?? 0,
+  days: plan.days ?? 30,
+  note: plan.note || "",
+  badge: plan.badge || "",
+  sortOrder: plan.sortOrder ?? 0,
+  isRecommended: Boolean(plan.isRecommended),
+  isActive: plan.isActive !== false,
+  isFree: Boolean(plan.isFree),
+  totalSalons: plan.totalSalons ?? 0,
+  activeSalons: plan.activeSalons ?? 0,
+});
+
+const PlansAndTrials = () => {
+  const navigate = useNavigate();
+  const [isLoading, setIsLoading] = useState(true);
+  const [plans, setPlans] = useState([]);
+  const [drafts, setDrafts] = useState({});
+  const [trial, setTrial] = useState({ id: "Free", days: 90, label: "Free trial" });
+  const [trialDirty, setTrialDirty] = useState(false);
+  const [orphaned, setOrphaned] = useState([]);
+  const [savingId, setSavingId] = useState("");
+  const [savingTrial, setSavingTrial] = useState(false);
+  const [creating, setCreating] = useState(false);
+  const [newPlan, setNewPlan] = useState({ label: "", price: "", days: "", note: "" });
+  const [confirming, setConfirming] = useState(""); // plan id awaiting a delete decision
+
+  useEffect(() => {
+    if (localStorage.getItem("role") === "distributor") {
+      navigate("/distributor", { replace: true });
+      return;
+    }
+    const tab = JSON.parse(localStorage.getItem("accessTab") || "null");
+    // `plans` is grantable on its own; role management (`user`) implies the super
+    // admin, who must be able to set prices without granting themselves the tab.
+    const hasAccess = tab === null || tab.includes("plans") || tab.includes("user");
+    if (!hasAccess) navigate("/login", { replace: true });
+  }, [navigate]);
+
+  const load = async () => {
+    try {
+      setIsLoading(true);
+      const result = await partnerPlanAPI.list();
+      if (!result.success) {
+        toast.error(result.message || "Failed to load the plans");
+        return;
+      }
+      const data = result.data || {};
+      const rows = Array.isArray(data.plans) ? data.plans.map(draftFrom) : [];
+      // The free trial is the row that carries `isFree`; the backend also sends
+      // `freeTrialDays` so this screen still shows the right number if the row
+      // is somehow missing.
+      const free = rows.find((row) => row.isFree) || null;
+      setPlans(rows.filter((row) => !row.isFree));
+      setDrafts(Object.fromEntries(rows.filter((row) => !row.isFree).map((row) => [row.id, row])));
+      setTrial({
+        id: free?.id || "Free",
+        label: free?.label || "Free trial",
+        days: free?.days ?? data.freeTrialDays ?? 90,
+        note: free?.note || "",
+      });
+      setTrialDirty(false);
+      setOrphaned(Array.isArray(data.orphaned) ? data.orphaned : []);
+    } catch {
+      toast.error("Failed to load the plans");
+    } finally {
+      setIsLoading(false);
+    }
+  };
+
+  useEffect(() => {
+    load();
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  const patch = (id, changes) =>
+    setDrafts((prev) => ({ ...prev, [id]: { ...prev[id], ...changes } }));
+
+  const savePlan = async (id) => {
+    const draft = drafts[id];
+    if (!draft) return;
+    if (!draft.label.trim()) {
+      toast.error("Give the plan a name — that is what salons see on the pricing screen.");
+      return;
+    }
+    const price = Number(draft.price);
+    const days = Number(draft.days);
+    if (!Number.isFinite(price) || price < 0) {
+      toast.error("The price must be 0 or more.");
+      return;
+    }
+    if (!Number.isFinite(days) || days < 1 || days > 3650) {
+      toast.error("The length must be between 1 and 3650 days.");
+      return;
+    }
+    if (price === 0 && !draft.isFree) {
+      toast.error("A paid plan must cost more than ₹0 — take it off sale instead.");
+      return;
+    }
+    try {
+      setSavingId(id);
+      const result = await partnerPlanAPI.update({
+        id,
+        label: draft.label.trim(),
+        price,
+        days: Math.round(days),
+        note: draft.note.trim(),
+        badge: draft.badge.trim(),
+        sortOrder: Number(draft.sortOrder) || 0,
+        isRecommended: Boolean(draft.isRecommended),
+        isActive: Boolean(draft.isActive),
+      });
+      if (result.success) {
+        toast.success(`${draft.label} saved — the website and app show it on their next load.`);
+        await load();
+      } else {
+        toast.error(result.message || "Failed to save the plan");
+      }
+    } catch {
+      toast.error("Failed to save the plan");
+    } finally {
+      setSavingId("");
+    }
+  };
+
+  const saveTrial = async () => {
+    const days = Number(trial.days);
+    if (!Number.isFinite(days) || days < 1 || days > 3650) {
+      toast.error("The trial must be between 1 and 3650 days.");
+      return;
+    }
+    try {
+      setSavingTrial(true);
+      const result = await partnerPlanAPI.update({
+        id: trial.id,
+        label: trial.label,
+        price: 0,
+        days: Math.round(days),
+        isActive: true,
+      });
+      if (result.success) {
+        toast.success(`New salons now get ${DURATION(days)} free.`);
+        await load();
+      } else {
+        toast.error(result.message || "Failed to save the trial length");
+      }
+    } catch {
+      toast.error("Failed to save the trial length");
+    } finally {
+      setSavingTrial(false);
+    }
+  };
+
+  const setActive = async (id, isActive) => {
+    const draft = drafts[id];
+    if (!draft) return;
+    try {
+      setSavingId(id);
+      const result = await partnerPlanAPI.update({ id, isActive });
+      if (result.success) {
+        toast.success(
+          isActive
+            ? `${draft.label} is on sale again.`
+            : `${draft.label} is off sale. Salons already on it keep their subscription.`
+        );
+        await load();
+      } else {
+        toast.error(result.message || "Failed to change the plan");
+      }
+    } catch {
+      toast.error("Failed to change the plan");
+    } finally {
+      setSavingId("");
+    }
+  };
+
+  const removePlan = async (id, deactivate) => {
+    const draft = drafts[id];
+    try {
+      setSavingId(id);
+      const result = await partnerPlanAPI.remove({ id, deactivate: Boolean(deactivate) });
+      if (result.success) {
+        toast.success(deactivate ? `${draft.label} taken off sale.` : `${draft.label} deleted.`);
+        setConfirming("");
+        await load();
+      } else {
+        toast.error(result.message || "Failed to remove the plan");
+      }
+    } catch {
+      toast.error("Failed to remove the plan");
+    } finally {
+      setSavingId("");
+    }
+  };
+
+  const createPlan = async () => {
+    if (!newPlan.label.trim()) {
+      toast.error("Give the new plan a name.");
+      return;
+    }
+    const price = Number(newPlan.price);
+    const days = Number(newPlan.days);
+    if (!Number.isFinite(price) || price <= 0) {
+      toast.error("A paid plan must cost more than ₹0.");
+      return;
+    }
+    if (!Number.isFinite(days) || days < 1 || days > 3650) {
+      toast.error("The length must be between 1 and 3650 days.");
+      return;
+    }
+    try {
+      setCreating(true);
+      const result = await partnerPlanAPI.create({
+        label: newPlan.label.trim(),
+        price,
+        days: Math.round(days),
+        note: newPlan.note.trim(),
+      });
+      if (result.success) {
+        toast.success(`${newPlan.label.trim()} created — it is on sale on the website and app now.`);
+        setNewPlan({ label: "", price: "", days: "", note: "" });
+        await load();
+      } else {
+        toast.error(result.message || "Failed to create the plan");
+      }
+    } catch {
+      toast.error("Failed to create the plan");
+    } finally {
+      setCreating(false);
+    }
+  };
+
+  const onSale = useMemo(() => plans.filter((plan) => plan.isActive !== false).length, [plans]);
+
+  return (
+    <Layout>
+      <div style={{ padding: "16px", maxWidth: "1400px", margin: "0 auto", boxSizing: "border-box" }}>
+        {/* Header */}
+        <div style={{ ...ROW_STYLE, marginBottom: "20px", padding: "20px" }}>
+          <div style={{ display: "flex", alignItems: "center", gap: "16px", flexWrap: "wrap" }}>
+            <div
+              style={{
+                display: "flex",
+                alignItems: "center",
+                justifyContent: "center",
+                background: "rgba(13, 110, 253, 0.1)",
+                color: "#0d6efd",
+                borderRadius: "12px",
+                width: "48px",
+                height: "48px",
+                flexShrink: 0,
+              }}
+            >
+              <Sparkles size={24} />
+            </div>
+            <div style={{ flex: "1 1 250px", minWidth: 0 }}>
+              <h4 style={{ margin: "0 0 4px 0", fontWeight: "700", color: "#212529", fontSize: "1.2rem" }}>
+                Plans &amp; Trials
+              </h4>
+              <p style={{ margin: 0, color: "#6c757d", fontSize: "0.85rem", lineHeight: "1.4" }}>
+                What a salon pays, how long each plan runs and how long a new salon is free. The
+                website and the app read this list — a change here reaches both without an app release.
+              </p>
+            </div>
+            <button
+              type="button"
+              onClick={load}
+              disabled={isLoading}
+              style={{
+                display: "inline-flex",
+                alignItems: "center",
+                gap: "8px",
+                padding: "9px 14px",
+                borderRadius: "8px",
+                border: "1px solid #ced4da",
+                background: "#ffffff",
+                color: "#495057",
+                fontSize: "0.875rem",
+                fontWeight: "600",
+                cursor: isLoading ? "not-allowed" : "pointer",
+              }}
+            >
+              <RefreshCw size={16} /> Reload
+            </button>
+          </div>
+        </div>
+
+        {isLoading ? (
+          <div style={{ ...ROW_STYLE, padding: "60px 0", textAlign: "center" }}>
+            <Loader size="md" />
+            <p style={{ color: "#6c757d", marginTop: "12px", fontSize: "0.875rem" }}>Loading the price list...</p>
+          </div>
+        ) : (
+          <>
+            {/* The free trial — the number the client asked to be 90 days */}
+            <div style={{ ...ROW_STYLE, padding: "20px", marginBottom: "20px", border: "1px solid #dbeafe" }}>
+              <div style={{ display: "flex", alignItems: "center", gap: "10px", marginBottom: "6px" }}>
+                <span
+                  style={{
+                    display: "flex",
+                    alignItems: "center",
+                    justifyContent: "center",
+                    background: "#eff6ff",
+                    color: "#0d6efd",
+                    borderRadius: "8px",
+                    width: "32px",
+                    height: "32px",
+                    flexShrink: 0,
+                  }}
+                >
+                  <CalendarClock size={18} />
+                </span>
+                <h5 style={{ margin: 0, fontWeight: "700", color: "#212529", fontSize: "1rem" }}>
+                  Free trial length
+                </h5>
+              </div>
+              <p style={{ margin: "0 0 14px 0", color: "#6c757d", fontSize: "0.82rem", lineHeight: "1.45", maxWidth: "720px" }}>
+                Every salon that registers starts on this window, automatically, without paying. A
+                salon that never subscribes simply expires when it ends. Salons already on a paid
+                plan are not affected.
+              </p>
+              <div style={{ display: "flex", flexWrap: "wrap", alignItems: "flex-end", gap: "12px" }}>
+                <div style={{ flex: "1 1 200px", maxWidth: "260px" }}>
+                  <label style={FIELD_LABEL} htmlFor="trial-days">
+                    Trial length (days)
+                  </label>
+                  <input
+                    id="trial-days"
+                    type="number"
+                    min="1"
+                    max="3650"
+                    style={INPUT}
+                    value={trial.days}
+                    onChange={(e) => {
+                      setTrial((prev) => ({ ...prev, days: e.target.value }));
+                      setTrialDirty(true);
+                    }}
+                  />
+                </div>
+                <div style={{ flex: "1 1 220px", paddingBottom: "9px" }}>
+                  <span style={{ fontSize: "0.85rem", color: "#495057", fontWeight: "600" }}>
+                    {DURATION(trial.days)} free
+                  </span>
+                  <span style={{ display: "block", fontSize: "0.78rem", color: "#6c757d", marginTop: "2px" }}>
+                    The portal shows this as “{DURATION(trial.days)} free trial”.
+                  </span>
+                </div>
+                <button
+                  type="button"
+                  onClick={saveTrial}
+                  disabled={savingTrial || !trialDirty}
+                  style={{
+                    display: "inline-flex",
+                    alignItems: "center",
+                    gap: "8px",
+                    padding: "10px 18px",
+                    borderRadius: "8px",
+                    border: "none",
+                    background: savingTrial || !trialDirty ? "#9ec5fe" : "#0d6efd",
+                    color: "#ffffff",
+                    fontSize: "0.9rem",
+                    fontWeight: "700",
+                    cursor: savingTrial || !trialDirty ? "not-allowed" : "pointer",
+                  }}
+                >
+                  <Save size={16} /> {savingTrial ? "Saving..." : "Save trial"}
+                </button>
+              </div>
+            </div>
+
+            {/* Legacy plans that no row covers */}
+            {orphaned.length > 0 && (
+              <div
+                style={{
+                  ...ROW_STYLE,
+                  padding: "16px 18px",
+                  marginBottom: "20px",
+                  border: "1px solid #fde68a",
+                  background: "#fffbeb",
+                  display: "flex",
+                  gap: "12px",
+                  alignItems: "flex-start",
+                }}
+              >
+                <Info size={18} style={{ color: "#b45309", flexShrink: 0, marginTop: "2px" }} />
+                <div style={{ fontSize: "0.85rem", color: "#92400e", lineHeight: "1.5" }}>
+                  <strong>
+                    {orphaned.reduce((sum, item) => sum + (item.totalSalons || 0), 0)} salon
+                    {orphaned.reduce((sum, item) => sum + (item.totalSalons || 0), 0) === 1 ? "" : "s"} are
+                    on a plan that is not in this list.
+                  </strong>{" "}
+                  They renew on the legacy duration (
+                  {orphaned.map((item) => `${item.id}: ${item.totalSalons}`).join(", ")}). Create a plan
+                  with that id if you want to control their price — existing ids are never changed
+                  automatically.
+                </div>
+              </div>
+            )}
+
+            {/* The price list */}
+            <div style={{ display: "flex", alignItems: "baseline", justifyContent: "space-between", gap: "12px", marginBottom: "12px", flexWrap: "wrap" }}>
+              <h5 style={{ margin: 0, fontWeight: "700", color: "#212529", fontSize: "1rem" }}>
+                Subscription plans
+              </h5>
+              <span style={{ fontSize: "0.8rem", color: "#6c757d" }}>
+                {onSale} of {plans.length} on sale
+              </span>
+            </div>
+
+            <div style={{ display: "flex", flexDirection: "column", gap: "14px" }}>
+              {plans.length === 0 && (
+                <div style={{ ...ROW_STYLE, padding: "28px", textAlign: "center", color: "#6c757d", fontSize: "0.9rem" }}>
+                  No paid plans yet. Add the first one below — until then only the free trial is
+                  offered on the website.
+                </div>
+              )}
+
