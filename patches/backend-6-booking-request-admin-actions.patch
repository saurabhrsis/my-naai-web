new file mode 100644
index 0000000..c0e2d46
--- /dev/null
+++ b/migrations/2026-11-05-booking-request-admin-actions.sql
@@ -0,0 +1,47 @@
+-- 2026-11-05-booking-request-admin-actions.sql
+--
+-- Admins can answer a booking request on a salon's behalf.
+--
+-- The API never needed a second table for this: a request is a lead, and
+-- answering it writes the queue entry + booking exactly as the salon's own
+-- answer does (services/bookingRequestAction.service.js). What it needs is a
+-- record of WHO answered, and an index for the admin tab's "today, newest
+-- first, every salon" page.
+--
+-- Every statement is idempotent, and the same DDL is run at boot by
+-- src/database/config/ensureShopSchema.js — so a deploy that forgets to run
+-- this file still works, and running it twice changes nothing.
+
+BEGIN;
+
+-- ── Who answered ────────────────────────────────────────────────────────────
+-- Null on every existing row. That is not missing data: before this release a
+-- request could only be answered by its own salon, so a null reads as "SALON".
+ALTER TABLE IF EXISTS booking_requests
+    ADD COLUMN IF NOT EXISTS acted_by_role       VARCHAR(16);
+
+ALTER TABLE IF EXISTS booking_requests
+    ADD COLUMN IF NOT EXISTS acted_by_admin_id   VARCHAR(64);
+
+ALTER TABLE IF EXISTS booking_requests
+    ADD COLUMN IF NOT EXISTS acted_at            TIMESTAMPTZ;
+
+ALTER TABLE IF EXISTS booking_requests
+    ADD COLUMN IF NOT EXISTS on_behalf_of_salon  BOOLEAN NOT NULL DEFAULT FALSE;
+
+-- The admin's short note (why it was accepted/rejected on the salon's behalf).
+-- Shown to the salon, never to the customer.
+ALTER TABLE IF EXISTS booking_requests
+    ADD COLUMN IF NOT EXISTS admin_note          TEXT;
+
+-- ── The page the admin tab opens on ────────────────────────────────────────
+-- Default window is TODAY (IST), ordered created_at DESC, filtered by salon /
+-- status / search. The existing (salon_id, status, created_at) index cannot
+-- serve "every salon, today", which is the default view.
+CREATE INDEX IF NOT EXISTS idx_booking_requests_created_at
+    ON booking_requests (created_at DESC);
+
+CREATE INDEX IF NOT EXISTS idx_booking_requests_status_created
+    ON booking_requests (status, created_at DESC);
+
+COMMIT;
diff --git a/src/controller/bookingRequest/adminBookingRequestAction.js b/src/controller/bookingRequest/adminBookingRequestAction.js
new file mode 100644
index 0000000..613c6b1
--- /dev/null
+++ b/src/controller/bookingRequest/adminBookingRequestAction.js
@@ -0,0 +1,48 @@
+const { applyRequestAction } = require('../../services/bookingRequestAction.service');
+
+/**
+ * An admin answering a lead on a salon's behalf.
+ *
+ * Body: `{ action: 'ACCEPT' | 'REJECT' | 'DELAY', delayMinutes?, reason? }`
+ *
+ * Why this exists: the Booking requests tab used to be read-only on purpose
+ * ("an admin does not accept on a salon's behalf"). That is no longer the
+ * operating rule — when a salon's phone is dead and the customer is standing at
+ * the counter, somebody has to take the chair. What has NOT changed is the
+ * reason the old rule existed: two answers to one request must never create two
+ * bookings. So this endpoint does not implement an accept; it calls
+ * `applyRequestAction` with `actor.role = 'ADMIN'`, which
+ *
+ *   · locks the request row for the whole transaction,
+ *   · refuses a request that already has a booking or an answer,
+ *   · refuses one past its 60 second window,
+ *   · records `acted_by_role / acted_by_admin_id / acted_at / on_behalf_of_salon`,
+ *   · tells the salon (in-app + socket) that My Naai answered for it.
+ *
+ * The salon id is the request's OWN salon — taken from the row after it is
+ * loaded, never from the body. `reason` is optional for an accept and expected
+ * for a reject; it is stored (500 chars) and shown to the salon.
+ */
+const adminBookingRequestAction = async (request, response) => {
+    const { action, delayMinutes = null, reason = null } = request.body || {};
+    const { bookingRequestId } = request.params;
+
+    // authenticateAdmin puts the Admin row on `request.admin`; its primary key
+    // is `id` (the token calls it adminId).
+    if (!request.admin?.id) {
+        return response.status(401).json({ status: 'FAILED', message: 'Not authorized' });
+    }
+
+    const result = await applyRequestAction({
+        bookingRequestId,
+        action,
+        delayMinutes,
+        reason,
+        actor: { role: 'ADMIN', adminId: request.admin.id },
+        io: request.io
+    });
+
+    return response.status(result.httpStatus).json(result.payload);
+};
+
+module.exports = adminBookingRequestAction;
