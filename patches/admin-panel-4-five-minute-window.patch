 src/pages/BookingRequests.jsx                |  3 +-
 src/utils/bookingWindow.js                   | 29 ++++++++++++++++++++
 3 files changed, 36 insertions(+), 6 deletions(-)
 create mode 100644 src/utils/bookingWindow.js

