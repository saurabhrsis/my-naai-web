+                    onClick={() => navigate("/notifications")}
+                    style={{
+                      width: '36px',
+                      height: '36px',
+                      borderRadius: '50%',
+                      padding: '0'
+                    }}
+                    title="Notifications"
+                    aria-label={notificationCount > 0 ? `Notifications, ${notificationCount} unread` : "Notifications"}
